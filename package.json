{
  "name": "zyzxerp-v2",
  "version": "0.1.0",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "ts-check": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "test:e2e": "pnpm run build && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "validate": "pnpm run ts-check && pnpm run lint && pnpm run test && pnpm run prisma:validate",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:diff": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script --output prisma/migrations/202607230001_initial/migration.sql",
    "prisma:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:sync-phone-skus": "tsx scripts/sync-phone-variant-skus.ts",
    "config:check:local": "node scripts/validate-config.mjs --mode=local --file=.env",
    "config:check:staging": "node scripts/validate-config.mjs --mode=staging --file=.env.staging",
    "deploy:dry-run": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deployment-dry-run.ps1",
    "backup:drill": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backup-restore-drill.ps1",
    "ship24:sync": "tsx scripts/ship24-sync.ts",
    "tracking:translate-backfill": "tsx scripts/backfill-tracking-translations.ts",
    "notifications:dispatch": "tsx scripts/dispatch-feishu-notifications.ts",
    "desktop:start": "electron .",
    "desktop:build": "electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@prisma/client": "^6.14.0",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "deep-email-validator": "^0.1.27",
    "exceljs": "4.4.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "1.10.0",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.66.1",
    "redis": "^6.1.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.1.10"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@storybook/addon-a11y": "^10.5.3",
    "@storybook/nextjs-vite": "^10.5.3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "electron": "^38.2.0",
    "electron-builder": "^26.0.20",
    "eslint-config-next": "16.2.11",
    "lucide-react": "^0.525.0",
    "prisma": "^6.14.0",
    "storybook": "^10.5.3",
    "tailwindcss": "^4",
    "tsx": "^4.20.3",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.zeyouzhenxuan.erp",
    "productName": "择优臻选 ERP",
    "artifactName": "ZY-ERP-Setup-${version}-${arch}.${ext}",
    "asar": true,
    "directories": {
      "output": "dist-desktop-final"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "icon": "desktop/assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "择优臻选 ERP",
      "uninstallDisplayName": "择优臻选 ERP",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "installerIcon": "desktop/assets/icon.ico",
      "uninstallerIcon": "desktop/assets/icon.ico",
      "installerHeaderIcon": "desktop/assets/icon.ico"
    }
  }
}
