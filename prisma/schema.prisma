model Conversation {
  id                  String             @id @default(uuid())
  legalEntityId       String
  businessUnitId      String
  departmentId        String?
  channelConnectionId String
  contactIdentityId   String
  providerThreadKey   String
  subject             String?
  preview             String?
  status              ConversationStatus @default(OPEN)
  priority            Int                @default(0)
  unreadCount         Int                @default(0)
  lastMessageAt       DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  legalEntity       LegalEntity                @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  businessUnit      BusinessUnit               @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  department        Department?                @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  channelConnection ChannelConnection          @relation(fields: [channelConnectionId], references: [id], onDelete: Cascade)
  contactIdentity   ContactIdentity            @relation(fields: [contactIdentityId], references: [id], onDelete: Restrict)
  messages          Message[]
  assignments       ConversationAssignment[]
  tags              ConversationTag[]
  customerLinks     ConversationCustomerLink[]
  auditEvents       InboxAuditEvent[]

  @@unique([channelConnectionId, providerThreadKey])
  @@index([businessUnitId, departmentId, status, lastMessageAt])
}

model Message {
  id                 String                @id @default(uuid())
  conversationId     String
  providerMessageKey String
  direction          MessageDirection
  deliveryStatus     MessageDeliveryStatus @default(RECEIVED)
  senderIdentity     String?
  contentText        String?
  contentType        String                @default("text")
