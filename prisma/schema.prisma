  createdAt      DateTime                       @default(now())
  updatedAt      DateTime                       @updatedAt

  importBatch LogisticsReturnImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)

  @@unique([importBatchId, rowNumber])
  @@index([importBatchId, status])
  @@index([orderId])
  @@index([shipmentId])
}

model LogisticsBatchArtifact {
