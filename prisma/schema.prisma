generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  DRAFT
  SUBMITTED
  WAITING_SHIPMENT
  SHIPPED
  DELIVERED
  EXCEPTION
  COMPLETED
  CANCELLED
}

enum ShipmentStatus {
  PENDING
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  EXCEPTION
  RETURNING
  RETURNED
  CLOSED
  CANCELLED
}

enum LogisticsIssueSeverity {
  LOW
  MEDIUM
  HIGH
}

enum LogisticsWorkStatus {
  MONITORING
  NEEDS_ATTENTION
  IN_PROGRESS
  WAITING_CUSTOMER
  WAITING_CARRIER
  RESOLVED
  NO_ACTION_REQUIRED
  CLOSED
}

enum LogisticsExportBatchStatus {
  EXPORTED
  SENT_TO_PROVIDER
  RETURN_PREVIEWED
  RETURN_IMPORTED
  CANCELLED
}

enum LogisticsReturnImportBatchStatus {
  PREVIEWED
  IMPORTED
  CANCELLED
}

enum LogisticsReturnImportRowStatus {
  READY
  WARNING
  REJECTED
  IMPORTED
}

enum LogisticsBatchArtifactKind {
  EXPORT_WORKBOOK
  RETURN_WORKBOOK
}

enum NotificationDeliveryStatus {
  PENDING
  PROCESSING
  RETRY
  SENT
  DEAD
}

enum AttendanceType {
  CHECK_IN
  CHECK_OUT
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELED
}

enum ApprovalStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  CANCELED
}

enum InventoryTransactionType {
  OPENING
  RECEIPT
  ADJUSTMENT
  RESERVE
  RELEASE
  SHIP
}

enum InventoryReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
  SYSTEM
}

enum MessageDeliveryStatus {
  RECEIVED
  QUEUED
  SENT
  DELIVERED
  FAILED
}

enum DeliveryAttemptStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  RETRYABLE
  FAILED
}

enum AttachmentStatus {
  ACTIVE
  DELETED
  QUARANTINED
}

// Finance facts are isolated from operational logistics. Amounts are always
// stored in the smallest currency unit using PostgreSQL BIGINT.
enum FinanceCounterpartyType {
  LOGISTICS_PROVIDER
  WAREHOUSE_PROVIDER
  SERVICE_PROVIDER
  OTHER
}

enum FinanceStatementType {
  COD_REMITTANCE
  SHIPPING_FEE
  WAREHOUSE_FEE
  RETURN_FEE
  OTHER
}

enum FinanceStatementStatus {
  DRAFT
  RECONCILING
  EXCEPTION
  APPROVED
  POSTED
  VOIDED
}

// An uploaded workbook is never a financial fact on its own. It remains a
// private, reviewable preview until an authorized person explicitly confirms
// creation of DRAFT statements.
enum FinanceStatementImportBatchStatus {
  PREVIEWED
  IMPORTING
  IMPORTED
  CANCELLED
}

enum FinanceStatementImportRowStatus {
  READY
  WARNING
  REJECTED
  IMPORTED
  SKIPPED
}

enum FinanceLineReconciliationStatus {
  UNMATCHED
  SUGGESTED
  MATCHED
  AMOUNT_MISMATCH
  IGNORED
}

enum FinanceReconciliationStatus {
  SUGGESTED
  CONFIRMED
  REJECTED
  IGNORED
  VOIDED
}

enum FinanceMatchMethod {
  MANUAL
  AUTOMATIC
}

enum FinancePaymentDirection {
  PAYABLE
  RECEIVABLE
}

enum FinancePaymentStatus {
  DRAFT
  APPROVED
  POSTED
  VOIDED
}

model LegalEntity {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businessUnits                 BusinessUnit[]
  memberships                   Membership[]
  customers                     Customer[]
  products                      Product[]
  orders                        Order[]
  documents                     Document[]
  announcements                 Announcement[]
  attendanceRecords             Attendance[]
  leaveRequests                 LeaveRequest[]
  expenses                      Expense[]
  auditLogs                     AuditLog[]
  shipments                     Shipment[]
  approvalRecords               ApprovalRecord[]
  orderTemplates                OrderTemplate[]
  logisticsTemplates            LogisticsProviderTemplate[]
  channelConnections            ChannelConnection[]
  conversations                 Conversation[]
  inboxAuditEvents              InboxAuditEvent[]
  attachments                   Attachment[]
  dailyGoals                    DailyGoal[]
  teamGoals                     TeamGoal[]
  logisticsExportBatches        LogisticsExportBatch[]
  logisticsReturnImportBatches  LogisticsReturnImportBatch[]
  logisticsBatchArtifacts       LogisticsBatchArtifact[]
  financeCounterparties         FinanceCounterparty[]
  financeStatements             FinanceStatement[]
  financeReconciliations        FinanceReconciliation[]
  financePayments               FinancePayment[]
  financeStatementTemplates     FinanceStatementTemplate[]
  financeStatementImportBatches FinanceStatementImportBatch[]
  financeControlPolicies        FinanceControlPolicy[]
}

model BusinessUnit {
  id            String   @id @default(uuid())
  legalEntityId String
  code          String
  name          String
  isActive      Boolean  @default(true)
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  legalEntity                   LegalEntity                   @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  departments                   Department[]
  sites                         Site[]
  memberships                   Membership[]
  auditLogs                     AuditLog[]
  accessGrants                  AccessGrant[]
  customers                     Customer[]
  products                      Product[]
  orders                        Order[]
  documents                     Document[]
  announcements                 Announcement[]
  attendance                    Attendance[]
  leaveRequests                 LeaveRequest[]
  expenses                      Expense[]
  shipments                     Shipment[]
  approvalRecords               ApprovalRecord[]
  inventoryBalances             InventoryBalance[]
  inventoryTransactions         InventoryTransaction[]
  inventoryReservations         InventoryReservation[]
  orderTemplates                OrderTemplate[]
  logisticsTemplates            LogisticsProviderTemplate[]
  logisticsFollowUps            LogisticsFollowUp[]
  logisticsEventAnnotations     LogisticsEventAnnotation[]
  logisticsWorkbenchSetting     LogisticsWorkbenchSetting?
  channelConnections            ChannelConnection[]
  contactIdentities             ContactIdentity[]
  conversations                 Conversation[]
  inboxTags                     InboxTag[]
  inboxAuditEvents              InboxAuditEvent[]
  attachments                   Attachment[]
  dailyGoals                    DailyGoal[]
  teamGoals                     TeamGoal[]
  notificationDeliveries        NotificationDelivery[]
  logisticsExportBatches        LogisticsExportBatch[]
  logisticsReturnImportBatches  LogisticsReturnImportBatch[]
  logisticsBatchArtifacts       LogisticsBatchArtifact[]
  financeCounterparties         FinanceCounterparty[]
  financeStatements             FinanceStatement[]
  financeReconciliations        FinanceReconciliation[]
  financePayments               FinancePayment[]
  financeStatementTemplates     FinanceStatementTemplate[]
  financeStatementImportBatches FinanceStatementImportBatch[]
  financeControlPolicy          FinanceControlPolicy?

  @@unique([legalEntityId, code])
  @@index([legalEntityId])
}

model Department {
  id             String   @id @default(uuid())
  businessUnitId String
  parentId       String?
  name           String
  code           String
  hierarchyPath  String?  @map("hierarchy_path")
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  businessUnit BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  parent       Department?  @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Department[] @relation("DepartmentTree")

  memberships                   Membership[]
  sites                         Site[]
  accessGrants                  AccessGrant[]
  customers                     Customer[]
  orders                        Order[]
  expenses                      Expense[]
  documents                     Document[]
  channelConnections            ChannelConnection[]
  conversations                 Conversation[]
  attachments                   Attachment[]
  teamGoals                     TeamGoal[]
  logisticsExportBatches        LogisticsExportBatch[]
  financeCounterparties         FinanceCounterparty[]
  financeStatements             FinanceStatement[]
  financePayments               FinancePayment[]
  financeStatementTemplates     FinanceStatementTemplate[]
  financeStatementImportBatches FinanceStatementImportBatch[]

  @@unique([businessUnitId, code, parentId])
  @@index([businessUnitId, parentId])
}

model Site {
  id             String   @id @default(uuid())
  code           String
  name           String
  businessUnitId String
  departmentId   String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  businessUnit BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  memberships                   Membership[]
  accessGrants                  AccessGrant[]
  orders                        Order[]
  expenses                      Expense[]
  documents                     Document[]
  announcements                 Announcement[]
  attendance                    Attendance[]
  shipments                     Shipment[]
  inventoryBalances             InventoryBalance[]
  inventoryTransactions         InventoryTransaction[]
  inventoryReservations         InventoryReservation[]
  financeStatements             FinanceStatement[]
  financePayments               FinancePayment[]
  financeStatementImportBatches FinanceStatementImportBatch[]

  @@unique([businessUnitId, code])
  @@index([departmentId])
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String   @unique
  fullName     String
  passwordHash String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships           Membership[]
  auditLogs             AuditLog[]
  orders                Order[]                @relation("OrderCreator")
  expenses              Expense[]
  documents             Document[]
  logisticsFollowUps    LogisticsFollowUp[]
  attendanceRecords     Attendance[]
  inventoryTransactions InventoryTransaction[]
  inboxAuditEvents      InboxAuditEvent[]      @relation("InboxAuditActor")
  attachments           Attachment[]           @relation("AttachmentUploader")
}

model Role {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships     Membership[]
  rolePermissions RolePermission[]
  menuPermissions MenuPermission[]
  delegationRules DelegationRule[] @relation("DelegationSourceRole")
}

model Action {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  namespace   String   @default("erp")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
  accessGrants    AccessGrant[]
  delegationRules DelegationRule[]
  requiredByMenus Menu[]           @relation("MenuRequiredAction")
}

model RolePermission {
  id         String   @id @default(uuid())
  roleId     String
  actionKey  String
  scope      String   @default("BUSINESS_UNIT")
  isAllowed  Boolean  @default(true)
  conditions Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  action Action @relation(fields: [actionKey], references: [key], onDelete: Cascade)

  @@unique([roleId, actionKey])
  @@index([roleId, scope])
}

model Menu {
  id                String   @id @default(uuid())
  key               String   @unique
  label             String
  path              String
  icon              String?
  parentId          String?
  sortOrder         Int      @default(0)
  isActive          Boolean  @default(true)
  requiredActionKey String?
  requiredCondition Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  parent         Menu?            @relation("MenuTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       Menu[]           @relation("MenuTree")
  requiredAction Action?          @relation("MenuRequiredAction", fields: [requiredActionKey], references: [key], onDelete: SetNull)
  grants         MenuPermission[]
}

model MenuPermission {
  id        String   @id @default(uuid())
  menuId    String
  roleId    String
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())

  menu Menu @relation(fields: [menuId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([menuId, roleId])
}

model Membership {
  id                  String    @id @default(uuid())
  userId              String
  businessUnitId      String
  departmentId        String?
  siteId              String?
  roleId              String
  managerMembershipId String?
  legalEntityId       String
  isPrimary           Boolean   @default(false)
  isActive            Boolean   @default(true)
  scope               String    @default("BUSINESS_UNIT")
  startedAt           DateTime  @default(now())
  endedAt             DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  legalEntity         LegalEntity  @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  businessUnit        BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  department          Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  site                Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)
  role                Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  managerMembership   Membership?  @relation("MembershipHierarchy", fields: [managerMembershipId], references: [id], onDelete: SetNull)
  directReports       Membership[] @relation("MembershipHierarchy")
  orders              Order[]      @relation("OrderOwner")
  claimedOrderReviews Order[]      @relation("OrderReviewClaim")

  grantedAccess  AccessGrant[] @relation("GrantedAccess")
  receivedAccess AccessGrant[] @relation("ReceivedAccess")

  actionAudits                           AuditLog[]                    @relation("ActorMembership")
  submittedApprovals                     ApprovalRecord[]              @relation("SubmittedApprovals")
  approvedApprovals                      ApprovalRecord[]              @relation("ApprovedApprovals")
  attendanceRecords                      Attendance[]                  @relation("MembershipAttendance")
  leaveRequests                          LeaveRequest[]                @relation("LeaveRequester")
  leaveApprovals                         LeaveRequest[]                @relation("LeaveApprover")
  shipmentEvents                         ShipmentEvent[]               @relation("MembershipShipmentEvents")
  ownedShipments                         Shipment[]                    @relation("ShipmentAftersalesOwner")
  logisticsFollowUps                     LogisticsFollowUp[]
  handledLogisticsAnnotations            LogisticsEventAnnotation[]    @relation("LogisticsAnnotationHandler")
  inventoryTransactions                  InventoryTransaction[]
  assignedConversations                  ConversationAssignment[]      @relation("ConversationAssignee")
  conversationAssignmentsMade            ConversationAssignment[]      @relation("ConversationAssigner")
  inboxAuditEvents                       InboxAuditEvent[]             @relation("InboxAuditMembership")
  uploadedAttachments                    Attachment[]                  @relation("AttachmentUploaderMembership")
  dailyGoals                             DailyGoal[]                   @relation("DailyGoalOwner")
  goalsSetForOthers                      DailyGoal[]                   @relation("DailyGoalSetter")
  teamGoalsSet                           TeamGoal[]                    @relation("TeamGoalSetter")
  logisticsExportBatches                 LogisticsExportBatch[]        @relation("LogisticsExportBatchCreator")
  logisticsReturnImportBatches           LogisticsReturnImportBatch[]  @relation("LogisticsReturnImportBatchPreviewer")
  logisticsBatchArtifacts                LogisticsBatchArtifact[]      @relation("LogisticsBatchArtifactCreator")
  createdFinanceCounterparties           FinanceCounterparty[]         @relation("FinanceCounterpartyCreator")
  createdFinanceStatements               FinanceStatement[]            @relation("FinanceStatementCreator")
  approvedFinanceStatements              FinanceStatement[]            @relation("FinanceStatementApprover")
  postedFinanceStatements                FinanceStatement[]            @relation("FinanceStatementPoster")
  voidedFinanceStatements                FinanceStatement[]            @relation("FinanceStatementVoider")
  createdFinanceReconciliations          FinanceReconciliation[]       @relation("FinanceReconciliationCreator")
  confirmedFinanceReconciliations        FinanceReconciliation[]       @relation("FinanceReconciliationConfirmer")
  voidedFinanceReconciliations           FinanceReconciliation[]       @relation("FinanceReconciliationVoider")
  createdFinancePayments                 FinancePayment[]              @relation("FinancePaymentCreator")
  approvedFinancePayments                FinancePayment[]              @relation("FinancePaymentApprover")
  postedFinancePayments                  FinancePayment[]              @relation("FinancePaymentPoster")
  voidedFinancePayments                  FinancePayment[]              @relation("FinancePaymentVoider")
  createdFinancePaymentAllocations       FinancePaymentAllocation[]    @relation("FinancePaymentAllocationCreator")
  createdFinanceStatementTemplates       FinanceStatementTemplate[]    @relation("FinanceStatementTemplateCreator")
  previewedFinanceStatementImportBatches FinanceStatementImportBatch[] @relation("FinanceStatementImportBatchPreviewer")
  confirmedFinanceStatementImportBatches FinanceStatementImportBatch[] @relation("FinanceStatementImportBatchConfirmer")
  cancelledFinanceStatementImportBatches FinanceStatementImportBatch[] @relation("FinanceStatementImportBatchCanceller")
  updatedFinanceControlPolicies          FinanceControlPolicy[]        @relation("FinanceControlPolicyUpdater")

  @@index([userId, isActive])
  @@index([businessUnitId, isActive])
  @@index([legalEntityId])
  @@index([managerMembershipId, isActive])
}

model AccessGrant {
  id                  String    @id @default(uuid())
  granteeMembershipId String
  granterMembershipId String
  actionKey           String
  scope               String    @default("DEPARTMENT")
  reason              String
  businessUnitId      String
  departmentId        String?
  siteId              String?
  grantedAt           DateTime  @default(now())
  expiresAt           DateTime?
  revokedAt           DateTime?
  isActive            Boolean   @default(true)

  action            Action       @relation(fields: [actionKey], references: [key], onDelete: Cascade)
  granteeMembership Membership   @relation("ReceivedAccess", fields: [granteeMembershipId], references: [id], onDelete: Cascade)
  granterMembership Membership   @relation("GrantedAccess", fields: [granterMembershipId], references: [id], onDelete: Cascade)
  businessUnit      BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  department        Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  site              Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@index([granteeMembershipId, isActive])
  @@index([granterMembershipId, isActive])
  @@index([expiresAt])
  @@index([businessUnitId, isActive])
}

model DelegationRule {
  id          String   @id @default(uuid())
  roleId      String
  actionKey   String
  canTransfer Boolean  @default(false)
  maxScope    String   @default("DEPARTMENT")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  role   Role   @relation("DelegationSourceRole", fields: [roleId], references: [id], onDelete: Cascade)
  action Action @relation(fields: [actionKey], references: [key], onDelete: Cascade)

  @@unique([roleId, actionKey])
}

model AuditLog {
  id                String   @id @default(uuid())
  action            String
  actorUserId       String?
  actorMembershipId String?
  module            String
  targetType        String
  targetId          String?
  legalEntityId     String?
  businessUnitId    String?
  roleId            String?
  details           Json?
  ipAddress         String?
  createdAt         DateTime @default(now())

  actorUser       User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorMembership Membership?   @relation("ActorMembership", fields: [actorMembershipId], references: [id], onDelete: SetNull)
  legalEntity     LegalEntity?  @relation(fields: [legalEntityId], references: [id], onDelete: SetNull)
  businessUnit    BusinessUnit? @relation(fields: [businessUnitId], references: [id], onDelete: SetNull)
}

model Customer {
  id             String   @id @default(uuid())
  legalEntityId  String
  businessUnitId String
  departmentId   String?
  code           String
  name           String
  contactName    String?
  contactPhone   String?
  contactEmail   String?
  taxId          String?
  address        String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  legalEntity       LegalEntity                @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  businessUnit      BusinessUnit               @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  department        Department?                @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  orders            Order[]
  conversationLinks ConversationCustomerLink[]

  @@unique([businessUnitId, code])
  @@index([legalEntityId, businessUnitId])
}

model Product {
  id             String   @id @default(uuid())
  legalEntityId  String
  businessUnitId String
  code           String
  name           String
  description    String?
  category       String?
  unit           String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  legalEntity  LegalEntity  @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  businessUnit BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  skus         ProductSku[]
  orderItems   OrderItem[]

  @@unique([businessUnitId, code])
  @@index([legalEntityId])
}

model ProductSku {
  id         String   @id @default(uuid())
  productId  String
  code       String
  barcode    String?
  attributes Json?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product               Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems            OrderItem[]
  inventoryBalances     InventoryBalance[]
  inventoryTransactions InventoryTransaction[]
  inventoryReservations InventoryReservation[]

  @@unique([productId, code])
  @@index([productId])
}

model Order {
  id                          String      @id @default(uuid())
  legalEntityId               String
  businessUnitId              String
  departmentId                String?
  siteId                      String?
  customerId                  String
  orderNo                     String
  creatorUserId               String
  ownedByMembershipId         String
  shopId                      String?
  orderTemplateId             String?
  status                      OrderStatus @default(DRAFT)
  currency                    String      @default("CNY")
  productValueCents           Int         @default(0)
  shippingFeeCents            Int         @default(0)
  codAmountCents              Int         @default(0)
  paidAmountCents             Int         @default(0)
  logisticsChannel            String?
  recipientName               String?
  recipientPhone              String?
  recipientEmail              String?
  emailValidationStatus       String?
  emailValidatedAt            DateTime?
  recipientCountryCode        String?
  recipientPostalCode         String?
  recipientRegion             String?
  recipientCity               String?
  recipientAddress            String?
  packageWeightGrams          Int?
  paymentMethod               String?
  customerWhatsapp            String?
  staffWhatsapp               String?
  orderedAt                   DateTime    @default(now())
  note                        String?
  exceptionNote               String?
  customFields                Json?
  templateSnapshot            Json?
  deliveredAt                 DateTime?
  reviewClaimedByMembershipId String?
  reviewClaimedAt             DateTime?
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime    @updatedAt

  legalEntity               LegalEntity                @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  businessUnit              BusinessUnit               @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  department                Department?                @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  site                      Site?                      @relation(fields: [siteId], references: [id], onDelete: SetNull)
  customer                  Customer                   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  creatorUser               User                       @relation("OrderCreator", fields: [creatorUserId], references: [id], onDelete: Restrict)
  ownerMembership           Membership                 @relation("OrderOwner", fields: [ownedByMembershipId], references: [id], onDelete: Restrict)
  reviewClaimedBy           Membership?                @relation("OrderReviewClaim", fields: [reviewClaimedByMembershipId], references: [id], onDelete: SetNull)
  orderTemplate             OrderTemplate?             @relation(fields: [orderTemplateId], references: [id], onDelete: SetNull)
  items                     OrderItem[]
  shipments                 Shipment[]
  expenses                  Expense[]
  inventoryTransactions     InventoryTransaction[]
  inventoryReservations     InventoryReservation[]
  logisticsExportBatchItems LogisticsExportBatchItem[]
  financeStatementLines     FinanceStatementLine[]
  financeReconciliations    FinanceReconciliation[]

  @@unique([businessUnitId, orderNo])
  @@index([legalEntityId, businessUnitId])
  @@index([businessUnitId, shopId])
  @@index([customerId, status])
  @@index([orderTemplateId])
  @@index([businessUnitId, recipientEmail])
  @@index([businessUnitId, status, reviewClaimedByMembershipId])
  @@index([businessUnitId, departmentId, creatorUserId, createdAt])
  @@index([businessUnitId, ownedByMembershipId, createdAt, id])
  @@index([businessUnitId, recipientCountryCode])
}

model OrderTemplate {
  id             String   @id @default(uuid())
  legalEntityId  String
  businessUnitId String
  code           String
  name           String
  description    String?
  configuration  Json
  isDefault      Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  legalEntity  LegalEntity  @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  businessUnit BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  orders       Order[]

  @@unique([businessUnitId, code])
  @@index([businessUnitId, isActive])
}

model LogisticsProviderTemplate {
  id             String   @id @default(uuid())
  legalEntityId  String
  businessUnitId String
  code           String
  name           String
  carrierName    String
  configuration  Json
  version        Int      @default(1)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  legalEntity   LegalEntity            @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  businessUnit  BusinessUnit           @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  exportBatches LogisticsExportBatch[]

  @@unique([businessUnitId, code])
  @@index([businessUnitId, isActive])
}

model LogisticsExportBatch {
  id                    String                     @id @default(uuid())
  legalEntityId         String
  businessUnitId        String
  departmentId          String?
  templateId            String
  templateVersion       Int
  batchNo               String
  templateSnapshot      Json
  orderCount            Int
  status                LogisticsExportBatchStatus @default(EXPORTED)
  dispatchNote          String?
  dispatchedAt          DateTime?
  createdByMembershipId String
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  legalEntity         LegalEntity                  @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  businessUnit        BusinessUnit                 @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  department          Department?                  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  template            LogisticsProviderTemplate    @relation(fields: [templateId], references: [id], onDelete: Restrict)
  createdByMembership Membership                   @relation("LogisticsExportBatchCreator", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  items               LogisticsExportBatchItem[]
  returnImports       LogisticsReturnImportBatch[]
  artifacts           LogisticsBatchArtifact[]

  @@unique([businessUnitId, batchNo])
  @@index([businessUnitId, status, createdAt])
  @@index([departmentId, createdAt])
  @@index([createdByMembershipId, createdAt])
}

model LogisticsExportBatchItem {
  id              String    @id @default(uuid())
  exportBatchId   String
  orderId         String
  orderNoSnapshot String
  rowHash         String
  payloadSnapshot Json
  trackingNo      String?
  importedAt      DateTime?
