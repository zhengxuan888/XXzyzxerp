model DocumentCategory {
  id             String   @id @default(uuid())
  legalEntityId  String
  businessUnitId String
  code           String
  name           String
  description    String?
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  legalEntity  LegalEntity  @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  businessUnit BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  documents    Document[]

  @@unique([businessUnitId, code])
  @@index([businessUnitId, isActive, sortOrder])
}

// Resource configuration is stored per business unit. Categories, statuses
// and lifecycle actions are data, so new kinds of equipment or software never
// require a role-name, department-name or business-unit-name code branch.
model ResourceCategory {
  id             String   @id @default(uuid())
  legalEntityId  String
  businessUnitId String
  code           String
  name           String
  description    String?
  isSoftware     Boolean  @default(false)
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  legalEntity  LegalEntity     @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  businessUnit BusinessUnit    @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  assets       ResourceAsset[]

  @@unique([businessUnitId, code])
  @@index([businessUnitId, isActive, sortOrder])
}

model ResourceStatus {
  id             String   @id @default(uuid())
  legalEntityId  String
  businessUnitId String
  code           String
  name           String
  color          String?
  isTerminal     Boolean  @default(false)
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  legalEntity        LegalEntity               @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  businessUnit       BusinessUnit              @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  assets             ResourceAsset[]           @relation("ResourceAssetStatus")
  sourceActions      ResourceLifecycleAction[] @relation("ResourceActionFromStatus")
  destinationActions ResourceLifecycleAction[] @relation("ResourceActionToStatus")
  eventsFrom         ResourceLifecycleEvent[]  @relation("ResourceLifecycleFromStatus")
  eventsTo           ResourceLifecycleEvent[]  @relation("ResourceLifecycleToStatus")

  @@unique([businessUnitId, code])
  @@index([businessUnitId, isActive, sortOrder])
}

model ResourceLifecycleAction {
  id                     String   @id @default(uuid())
  legalEntityId          String
  businessUnitId         String
  code                   String
  name                   String
  fromStatusId           String?
  toStatusId             String?
  availableQuantityDelta Int      @default(0)
  archiveAsset           Boolean  @default(false)
  requiresAssignee       Boolean  @default(false)
  sortOrder              Int      @default(0)
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  legalEntity  LegalEntity              @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  businessUnit BusinessUnit             @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  fromStatus   ResourceStatus?          @relation("ResourceActionFromStatus", fields: [fromStatusId], references: [id], onDelete: SetNull)
  toStatus     ResourceStatus?          @relation("ResourceActionToStatus", fields: [toStatusId], references: [id], onDelete: SetNull)
  events       ResourceLifecycleEvent[]

  @@unique([businessUnitId, code])
  @@index([businessUnitId, isActive, sortOrder])
  @@index([fromStatusId])
  @@index([toStatusId])
}

// ResourceAsset is the safe, organisation-scoped asset ledger. It holds only
// operational metadata. Passwords, API tokens, full licence keys and other
// secrets deliberately have no columns and must never be put in audit JSON.
model ResourceAsset {
  id                    String    @id @default(uuid())
  legalEntityId         String
  businessUnitId        String
  departmentId          String?
  siteId                String?
  categoryId            String
  statusId              String
  resourceNo            String
  name                  String
  brandModel            String?
  serialNumber          String?
  ownership             String?
  location              String?
  quantity              Int       @default(1)
  availableQuantity     Int       @default(1)
  lowStockThreshold     Int       @default(0)
  currency              String    @default("CNY")
  valueCents            BigInt?
  purchasedAt           DateTime?
  expiresAt             DateTime?
  note                  String?
  assignedMembershipId  String?
  createdByMembershipId String
  isActive              Boolean   @default(true)
  archivedAt            DateTime?
  // Incremented on every mutable change. APIs use this for optimistic locking
  // so two concurrent lifecycle actions cannot silently overwrite inventory.
  version               Int       @default(1)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  legalEntity         LegalEntity              @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  businessUnit        BusinessUnit             @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  department          Department?              @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  site                Site?                    @relation(fields: [siteId], references: [id], onDelete: SetNull)
  category            ResourceCategory         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  status              ResourceStatus           @relation("ResourceAssetStatus", fields: [statusId], references: [id], onDelete: Restrict)
  assignedMembership  Membership?              @relation("ResourceAssetAssignee", fields: [assignedMembershipId], references: [id], onDelete: SetNull)
  createdByMembership Membership               @relation("ResourceAssetCreator", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  softwareProfile     SoftwareAssetProfile?
  lifecycleEvents     ResourceLifecycleEvent[]

  @@unique([businessUnitId, resourceNo])
  @@index([businessUnitId, isActive, updatedAt, id])
  @@index([businessUnitId, categoryId, statusId])
  @@index([businessUnitId, departmentId, siteId])
  @@index([assignedMembershipId, isActive])
  @@index([expiresAt])
}

// A software profile is one optional, safe view of a resource category marked
// as software. It tracks licences and renewal facts but intentionally stores
// only an account label/identifier, never an account password or token.
model SoftwareAssetProfile {
  id                String   @id @default(uuid())
  resourceAssetId   String   @unique
  platform          String?
  accountIdentifier String?
  licenseType       String?
  seatsTotal        Int?
  seatsUsed         Int      @default(0)
  autoRenewal       Boolean  @default(false)
  renewalCostCents  BigInt?
  renewalCurrency   String   @default("CNY")
  renewalCycle      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  resourceAsset ResourceAsset @relation(fields: [resourceAssetId], references: [id], onDelete: Cascade)
}

// Events are append-only operational history. ResourceAsset keeps the current
// projection, while this table preserves who performed a transfer, return,
// repair or archive transition and what changed at that time.
model ResourceLifecycleEvent {
  id                       String   @id @default(uuid())
  resourceAssetId          String
  legalEntityId            String
  businessUnitId           String
  departmentId             String?
  siteId                   String?
  lifecycleActionId        String
  fromStatusId             String?
  toStatusId               String?
  fromAssigneeMembershipId String?
  toAssigneeMembershipId   String?
  availableQuantityBefore  Int
  availableQuantityAfter   Int
  note                     String?
  performedByMembershipId  String
  occurredAt               DateTime @default(now())
  createdAt                DateTime @default(now())

  resourceAsset          ResourceAsset           @relation(fields: [resourceAssetId], references: [id], onDelete: Cascade)
  legalEntity            LegalEntity             @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  businessUnit           BusinessUnit            @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  department             Department?             @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  site                   Site?                   @relation(fields: [siteId], references: [id], onDelete: SetNull)
  lifecycleAction        ResourceLifecycleAction @relation(fields: [lifecycleActionId], references: [id], onDelete: Restrict)
  fromStatus             ResourceStatus?         @relation("ResourceLifecycleFromStatus", fields: [fromStatusId], references: [id], onDelete: SetNull)
  toStatus               ResourceStatus?         @relation("ResourceLifecycleToStatus", fields: [toStatusId], references: [id], onDelete: SetNull)
  performedByMembership  Membership              @relation("ResourceLifecycleActor", fields: [performedByMembershipId], references: [id], onDelete: Restrict)
  fromAssigneeMembership Membership?             @relation("ResourceLifecycleFromAssignee", fields: [fromAssigneeMembershipId], references: [id], onDelete: SetNull)
  toAssigneeMembership   Membership?             @relation("ResourceLifecycleToAssignee", fields: [toAssigneeMembershipId], references: [id], onDelete: SetNull)

  @@index([resourceAssetId, occurredAt, id])
  @@index([businessUnitId, occurredAt])
  @@index([toAssigneeMembershipId, occurredAt])
}

model ChannelConnection {
  id             String    @id @default(uuid())
  legalEntityId  String
  businessUnitId String
  departmentId   String?
  providerKey    String
  displayName    String
  externalRef    String?
  configuration  Json?
  isActive       Boolean   @default(true)
  lastSyncAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  legalEntity      LegalEntity       @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  businessUnit     BusinessUnit      @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  department       Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  identities       ContactIdentity[]
  conversations    Conversation[]
  syncCursors      SyncCursor[]
  deliveryAttempts DeliveryAttempt[]

  @@unique([businessUnitId, providerKey, externalRef])
  @@index([businessUnitId, departmentId, isActive])
}

model ContactIdentity {
  id                  String   @id @default(uuid())
  businessUnitId      String
  channelConnectionId String
  providerContactKey  String
  displayName         String?
  normalizedAddress   String?
  avatarUrl           String?
  metadata            Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  businessUnit      BusinessUnit      @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  channelConnection ChannelConnection @relation(fields: [channelConnectionId], references: [id], onDelete: Cascade)
  conversations     Conversation[]

  @@unique([channelConnectionId, providerContactKey])
  @@index([businessUnitId, normalizedAddress])
}

model Conversation {
  id                  String             @id @default(uuid())
  legalEntityId       String
  businessUnitId      String
  departmentId        String?
  channelConnectionId String
  contactIdentityId   String
  providerThreadKey   String
  subject             String?
  preview             String?
  status              ConversationStatus @default(OPEN)
  priority            Int                @default(0)
  unreadCount         Int                @default(0)
  lastMessageAt       DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  legalEntity       LegalEntity                @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  businessUnit      BusinessUnit               @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  department        Department?                @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  channelConnection ChannelConnection          @relation(fields: [channelConnectionId], references: [id], onDelete: Cascade)
  contactIdentity   ContactIdentity            @relation(fields: [contactIdentityId], references: [id], onDelete: Restrict)
  messages          Message[]
  assignments       ConversationAssignment[]
  tags              ConversationTag[]
  customerLinks     ConversationCustomerLink[]
  auditEvents       InboxAuditEvent[]

  @@unique([channelConnectionId, providerThreadKey])
  @@index([businessUnitId, departmentId, status, lastMessageAt])
}

model Message {
  id                 String                @id @default(uuid())
  conversationId     String
  providerMessageKey String
  direction          MessageDirection
  deliveryStatus     MessageDeliveryStatus @default(RECEIVED)
  senderIdentity     String?
  contentText        String?
  contentType        String                @default("text")
  occurredAt         DateTime
  rawMetadata        Json?
  createdAt          DateTime              @default(now())

  conversation     Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  deliveryAttempts DeliveryAttempt[]

  @@unique([conversationId, providerMessageKey])
  @@index([conversationId, occurredAt])
}

model ConversationCustomerLink {
  id             String   @id @default(uuid())
  conversationId String
  customerId     String
  linkType       String   @default("CUSTOMER")
  linkedAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([conversationId, customerId])
}

model ConversationAssignment {
  id                     String    @id @default(uuid())
  conversationId         String
  assigneeMembershipId   String
  assignedByMembershipId String
  isActive               Boolean   @default(true)
  assignedAt             DateTime  @default(now())
  endedAt                DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  assignee     Membership   @relation("ConversationAssignee", fields: [assigneeMembershipId], references: [id], onDelete: Restrict)
  assignedBy   Membership   @relation("ConversationAssigner", fields: [assignedByMembershipId], references: [id], onDelete: Restrict)

  @@index([conversationId, isActive])
  @@index([assigneeMembershipId, isActive])
}

model InboxTag {
  id             String   @id @default(uuid())
  businessUnitId String
  name           String
  color          String   @default("violet")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  businessUnit  BusinessUnit      @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  conversations ConversationTag[]

  @@unique([businessUnitId, name])
}

model ConversationTag {
  conversationId String
  tagId          String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tag          InboxTag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([conversationId, tagId])
}

model DeliveryAttempt {
  id                  String                @id @default(uuid())
  channelConnectionId String
  messageId           String?
  operation           String
  idempotencyKey      String
  status              DeliveryAttemptStatus @default(PENDING)
  attemptCount        Int                   @default(0)
  nextRetryAt         DateTime?
  lastErrorCode       String?
  lastErrorMessage    String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  channelConnection ChannelConnection @relation(fields: [channelConnectionId], references: [id], onDelete: Cascade)
  message           Message?          @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@unique([channelConnectionId, idempotencyKey])
  @@index([status, nextRetryAt])
}

model SyncCursor {
  id                  String    @id @default(uuid())
  channelConnectionId String
  cursorKey           String
  cursorValue         String?
  lockedAt            DateTime?
  lastSuccessAt       DateTime?
  lastErrorAt         DateTime?
  lastErrorCode       String?
  updatedAt           DateTime  @updatedAt

  channelConnection ChannelConnection @relation(fields: [channelConnectionId], references: [id], onDelete: Cascade)

  @@unique([channelConnectionId, cursorKey])
}

model InboxAuditEvent {
  id                String   @id @default(uuid())
  legalEntityId     String
  businessUnitId    String
  conversationId    String?
  actorUserId       String?
  actorMembershipId String?
  eventType         String
  details           Json?
  createdAt         DateTime @default(now())

  legalEntity     LegalEntity   @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  businessUnit    BusinessUnit  @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  conversation    Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  actorUser       User?         @relation("InboxAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorMembership Membership?   @relation("InboxAuditMembership", fields: [actorMembershipId], references: [id], onDelete: SetNull)

  @@index([businessUnitId, conversationId, createdAt])
}

// A workbench is a configuration record, not a hard-coded dashboard. The
// cards carry audience/zone/order data and are validated server-side before
// persistence so an authorized user can change the layout without a deploy.
model MarketingWorkbenchSetting {
  id              String   @id @default(uuid())
  legalEntityId   String
  businessUnitId  String   @unique
  cards           Json
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  legalEntity   LegalEntity  @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  businessUnit  BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  updatedByUser User?        @relation("MarketingWorkbenchSettingUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)
}

// A source is a configuration record. It can represent a platform, account,
// campaign or any future reporting dimension without putting those names in
// application logic. The optional parent makes a configurable source tree.
model MarketingSource {
  id             String   @id @default(uuid())
  legalEntityId  String
  businessUnitId String
  departmentId   String?
  siteId         String?
  parentId       String?
  code           String
  name           String
  kind           String   @default("SOURCE")
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  legalEntity  LegalEntity            @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  businessUnit BusinessUnit           @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  department   Department?            @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  site         Site?                  @relation(fields: [siteId], references: [id], onDelete: SetNull)
  parent       MarketingSource?       @relation("MarketingSourceTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     MarketingSource[]      @relation("MarketingSourceTree")
  reports      MarketingDailyReport[]
  creatives    MarketingCreative[]

  @@unique([businessUnitId, code])
  @@index([businessUnitId, parentId, isActive, sortOrder])
  @@index([departmentId, siteId])
}

// Definitions make metric labels, types, input requirements and safe ratio
// formulas configuration-driven. There is deliberately no free-form formula
// execution or code branch for an ad platform.
model MarketingMetricDefinition {
  id                    String                     @id @default(uuid())
  legalEntityId         String
  businessUnitId        String
  code                  String
  name                  String
  valueType             MarketingMetricValueType
  aggregation           MarketingMetricAggregation @default(SUM)
  calculation           MarketingMetricCalculation @default(DIRECT)
  numeratorMetricCode   String?
  denominatorMetricCode String?
  multiplier            Decimal?                   @db.Decimal(20, 6)
  inputRequired         Boolean                    @default(false)
  showOnWorkbench       Boolean                    @default(false)
  sortOrder             Int                        @default(0)
  isActive              Boolean                    @default(true)
  description           String?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  legalEntity    LegalEntity                    @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  businessUnit   BusinessUnit                   @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  values         MarketingDailyMetricValue[]
  kpiTargets     MarketingKpiTarget[]
  creativeValues MarketingCreativeMetricValue[]

  @@unique([businessUnitId, code])
  @@index([businessUnitId, isActive, sortOrder])
}

// A daily report records raw facts for one employee, source and day. Ratios
// such as CTR/CPA/ROAS are derived only from metric definitions and never
// accepted as untraceable client-side calculations.
model MarketingDailyReport {
  id                     String                @id @default(uuid())
  legalEntityId          String
  businessUnitId         String
  departmentId           String?
  siteId                 String?
  sourceId               String
  productId              String?
  ownerMembershipId      String
  createdByUserId        String
  reportDate             DateTime              @db.Date
  marketCode             String?
  currency               String                @default("EUR")
  note                   String?
  status                 MarketingReportStatus @default(DRAFT)
  submittedAt            DateTime?
  reviewedByMembershipId String?
  reviewedAt             DateTime?
  returnReason           String?
  lockedByMembershipId   String?
  lockedAt               DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  legalEntity          LegalEntity                 @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  businessUnit         BusinessUnit                @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  department           Department?                 @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  site                 Site?                       @relation(fields: [siteId], references: [id], onDelete: SetNull)
  source               MarketingSource             @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  product              Product?                    @relation(fields: [productId], references: [id], onDelete: SetNull)
  ownerMembership      Membership                  @relation("MarketingReportOwner", fields: [ownerMembershipId], references: [id], onDelete: Restrict)
  createdByUser        User                        @relation("MarketingReportCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  reviewedByMembership Membership?                 @relation("MarketingReportReviewer", fields: [reviewedByMembershipId], references: [id], onDelete: SetNull)
  lockedByMembership   Membership?                 @relation("MarketingReportLocker", fields: [lockedByMembershipId], references: [id], onDelete: SetNull)
  metricValues         MarketingDailyMetricValue[]

  @@unique([businessUnitId, ownerMembershipId, sourceId, reportDate])
  @@index([businessUnitId, reportDate, status])
  @@index([businessUnitId, departmentId, reportDate])
  @@index([ownerMembershipId, reportDate])
  @@index([sourceId, reportDate])
}

model MarketingDailyMetricValue {
  id                 String   @id @default(uuid())
  reportId           String
  metricDefinitionId String
  valueCents         BigInt?
  valueDecimal       Decimal? @db.Decimal(22, 6)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  report           MarketingDailyReport      @relation(fields: [reportId], references: [id], onDelete: Cascade)
  metricDefinition MarketingMetricDefinition @relation(fields: [metricDefinitionId], references: [id], onDelete: Restrict)

  @@unique([reportId, metricDefinitionId])
  @@index([metricDefinitionId])
}

// KPI targets use the same configured metric definition as reports. Scope is
// explicit and validated on the server; the scope key is kept for a stable
// unique constraint and is never treated as an untrusted client permission.
model MarketingKpiTarget {
  id                 String                @id @default(uuid())
  legalEntityId      String
  businessUnitId     String
  departmentId       String?
  targetMembershipId String?
  metricDefinitionId String
  scopeType          MarketingKpiScopeType
  scopeKey           String
  periodStart        DateTime              @db.Date
  periodEnd          DateTime              @db.Date
  targetCents        BigInt?
  targetDecimal      Decimal?              @db.Decimal(22, 6)
  currency           String                @default("EUR")
  note               String?
  setByMembershipId  String
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  legalEntity      LegalEntity               @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  businessUnit     BusinessUnit              @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  department       Department?               @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  targetMembership Membership?               @relation("MarketingKpiTargetMembership", fields: [targetMembershipId], references: [id], onDelete: SetNull)
  metricDefinition MarketingMetricDefinition @relation(fields: [metricDefinitionId], references: [id], onDelete: Restrict)
  setByMembership  Membership                @relation("MarketingKpiTargetSetter", fields: [setByMembershipId], references: [id], onDelete: Restrict)

  @@unique([businessUnitId, metricDefinitionId, scopeType, scopeKey, periodStart, periodEnd])
  @@index([businessUnitId, periodStart, periodEnd])
  @@index([departmentId, periodStart, periodEnd])
  @@index([targetMembershipId, periodStart, periodEnd])
}

// Creative lifecycle and tags are data records, allowing a permitted manager
// to add a new status or classification without a code deployment.
model MarketingCreativeStatus {
  id             String   @id @default(uuid())
  legalEntityId  String
  businessUnitId String
  code           String
  name           String
  color          String?
  isTerminal     Boolean  @default(false)
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  legalEntity  LegalEntity         @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  businessUnit BusinessUnit        @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  creatives    MarketingCreative[]

  @@unique([businessUnitId, code])
  @@index([businessUnitId, isActive, sortOrder])
}

model MarketingTag {
  id             String   @id @default(uuid())
  legalEntityId  String
  businessUnitId String
  name           String
  color          String?
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  legalEntity  LegalEntity            @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  businessUnit BusinessUnit           @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  creatives    MarketingCreativeTag[]

  @@unique([businessUnitId, name])
  @@index([businessUnitId, isActive, sortOrder])
}

model MarketingCreative {
  id                String   @id @default(uuid())
  legalEntityId     String
  businessUnitId    String
  departmentId      String?
  siteId            String?
  sourceId          String?
  productId         String?
  statusId          String
  ownerMembershipId String
  createdByUserId   String
  code              String
  name              String
  marketCode        String?
  languageCode      String?
  description       String?
  isArchived        Boolean  @default(false)
  retiredReason     String?
  metadata          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  legalEntity     LegalEntity                    @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  businessUnit    BusinessUnit                   @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  department      Department?                    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  site            Site?                          @relation(fields: [siteId], references: [id], onDelete: SetNull)
  source          MarketingSource?               @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  product         Product?                       @relation(fields: [productId], references: [id], onDelete: SetNull)
  status          MarketingCreativeStatus        @relation(fields: [statusId], references: [id], onDelete: Restrict)
  ownerMembership Membership                     @relation("MarketingCreativeOwner", fields: [ownerMembershipId], references: [id], onDelete: Restrict)
  createdByUser   User                           @relation("MarketingCreativeCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  assets          MarketingCreativeAttachment[]
  tags            MarketingCreativeTag[]
  metricValues    MarketingCreativeMetricValue[]

  @@unique([businessUnitId, code])
  @@index([businessUnitId, statusId, isArchived, updatedAt])
  @@index([businessUnitId, departmentId, ownerMembershipId])
  @@index([sourceId, productId])
}

model MarketingCreativeAttachment {
  id           String                        @id @default(uuid())
  creativeId   String
  attachmentId String
  purpose      MarketingCreativeAssetPurpose @default(PRIMARY)
  sortOrder    Int                           @default(0)
  createdAt    DateTime                      @default(now())

  creative   MarketingCreative @relation(fields: [creativeId], references: [id], onDelete: Cascade)
  attachment Attachment        @relation(fields: [attachmentId], references: [id], onDelete: Cascade)

  @@unique([creativeId, attachmentId])
  @@index([attachmentId])
  @@index([creativeId, purpose, sortOrder])
}

model MarketingCreativeTag {
  creativeId String
  tagId      String
  createdAt  DateTime @default(now())

  creative MarketingCreative @relation(fields: [creativeId], references: [id], onDelete: Cascade)
  tag      MarketingTag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([creativeId, tagId])
  @@index([tagId])
}

model MarketingCreativeMetricValue {
  id                 String   @id @default(uuid())
  creativeId         String
  metricDefinitionId String
  recordedOn         DateTime @db.Date
  valueCents         BigInt?
  valueDecimal       Decimal? @db.Decimal(22, 6)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  creative         MarketingCreative         @relation(fields: [creativeId], references: [id], onDelete: Cascade)
  metricDefinition MarketingMetricDefinition @relation(fields: [metricDefinitionId], references: [id], onDelete: Restrict)

  @@unique([creativeId, metricDefinitionId, recordedOn])
  @@index([metricDefinitionId, recordedOn])
}

model Attachment {
  id                     String           @id @default(uuid())
  legalEntityId          String
  businessUnitId         String
  departmentId           String?
  targetType             String
  targetId               String
  originalName           String
  storageProvider        String
  storageKey             String           @unique
  mimeType               String
  extension              String
  sizeBytes              Int
  sha256                 String
  status                 AttachmentStatus @default(ACTIVE)
  uploadedByUserId       String
  uploadedByMembershipId String
  deletedAt              DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  legalEntity             LegalEntity                   @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  businessUnit            BusinessUnit                  @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  department              Department?                   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  uploadedByUser          User                          @relation("AttachmentUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  uploadedByMembership    Membership                    @relation("AttachmentUploaderMembership", fields: [uploadedByMembershipId], references: [id], onDelete: Restrict)
  document                Document?                     @relation("DocumentAttachment")
  marketingCreativeAssets MarketingCreativeAttachment[]

  @@index([businessUnitId, departmentId, targetType, targetId, status])
  @@index([sha256])
}

model DailyGoal {
  id                String   @id @default(uuid())
  legalEntityId     String
  businessUnitId    String
  membershipId      String
  goalDate          DateTime @db.Date
  targetOrderCount  Int      @default(0)
  targetAmountCents Int      @default(0)
  currency          String   @default("EUR")
  note              String?
  setByMembershipId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  legalEntity     LegalEntity  @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  businessUnit    BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  membership      Membership   @relation("DailyGoalOwner", fields: [membershipId], references: [id], onDelete: Cascade)
  setByMembership Membership   @relation("DailyGoalSetter", fields: [setByMembershipId], references: [id], onDelete: Restrict)

  @@unique([businessUnitId, membershipId, goalDate])
  @@index([businessUnitId, goalDate])
  @@index([membershipId, goalDate])
}

model TeamGoal {
  id                String   @id @default(uuid())
  legalEntityId     String
  businessUnitId    String
  departmentId      String?
  scopeType         String
  scopeKey          String
  goalDate          DateTime @db.Date
  targetOrderCount  Int      @default(0)
  targetAmountCents Int      @default(0)
  currency          String   @default("EUR")
  note              String?
  setByMembershipId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  legalEntity     LegalEntity  @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  businessUnit    BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  department      Department?  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  setByMembership Membership   @relation("TeamGoalSetter", fields: [setByMembershipId], references: [id], onDelete: Restrict)

  @@unique([businessUnitId, scopeKey, goalDate])
  @@index([businessUnitId, goalDate])
  @@index([departmentId, goalDate])
}

model Country {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}
