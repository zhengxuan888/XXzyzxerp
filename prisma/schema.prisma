generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  DRAFT
  SUBMITTED
  WAITING_SHIPMENT
  SHIPPED
  DELIVERED
  EXCEPTION
  COMPLETED
  CANCELLED
}

enum ShipmentStatus {
  PENDING
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  EXCEPTION
  RETURNING
  RETURNED
  CLOSED
  CANCELLED
}

enum LogisticsIssueSeverity {
  LOW
  MEDIUM
  HIGH
}

enum LogisticsWorkStatus {
  MONITORING
  NEEDS_ATTENTION
  IN_PROGRESS
  WAITING_CUSTOMER
  WAITING_CARRIER
  RESOLVED
  NO_ACTION_REQUIRED
  CLOSED
}

enum LogisticsExportBatchStatus {
  EXPORTED
  SENT_TO_PROVIDER
  RETURN_PREVIEWED
  RETURN_IMPORTED
  CANCELLED
}

enum LogisticsReturnImportBatchStatus {
  PREVIEWED
  IMPORTED
  CANCELLED
}

enum LogisticsReturnImportRowStatus {
  READY
  WARNING
  REJECTED
  IMPORTED
}

enum LogisticsBatchArtifactKind {
  EXPORT_WORKBOOK
  RETURN_WORKBOOK
}

enum NotificationDeliveryStatus {
  PENDING
  PROCESSING
  RETRY
  SENT
  DEAD
}

enum AttendanceType {
  CHECK_IN
  CHECK_OUT
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELED
}

enum ApprovalStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  CANCELED
}

enum InventoryTransactionType {
  OPENING
  RECEIPT
  ADJUSTMENT
  RESERVE
  RELEASE
  SHIP
}

enum InventoryReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
  SYSTEM
}

enum MessageDeliveryStatus {
  RECEIVED
  QUEUED
  SENT
  DELIVERED
  FAILED
}

enum DeliveryAttemptStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  RETRYABLE
  FAILED
}

enum AttachmentStatus {
  ACTIVE
  DELETED
  QUARANTINED
}

enum DocumentReviewStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

// Finance facts are isolated from operational logistics. Amounts are always
// stored in the smallest currency unit using PostgreSQL BIGINT.
enum FinanceCounterpartyType {
  LOGISTICS_PROVIDER
  WAREHOUSE_PROVIDER
  SERVICE_PROVIDER
  OTHER
}

enum FinanceStatementType {
  COD_REMITTANCE
  SHIPPING_FEE
  WAREHOUSE_FEE
  RETURN_FEE
  OTHER
}

enum FinanceStatementStatus {
  DRAFT
  RECONCILING
  EXCEPTION
  APPROVED
  POSTED
  VOIDED
}

// An uploaded workbook is never a financial fact on its own. It remains a
// private, reviewable preview until an authorized person explicitly confirms
// creation of DRAFT statements.
enum FinanceStatementImportBatchStatus {
  PREVIEWED
  IMPORTING
  IMPORTED
  CANCELLED
}

enum FinanceStatementImportRowStatus {
  READY
  WARNING
  REJECTED
  IMPORTED
  SKIPPED
}

enum FinanceLineReconciliationStatus {
  UNMATCHED
  SUGGESTED
  MATCHED
  AMOUNT_MISMATCH
  IGNORED
}

enum FinanceReconciliationStatus {
  SUGGESTED
  CONFIRMED
  REJECTED
  IGNORED
  VOIDED
}

enum FinanceMatchMethod {
  MANUAL
  AUTOMATIC
}

enum FinancePaymentDirection {
  PAYABLE
  RECEIVABLE
}

enum FinancePaymentStatus {
  DRAFT
  APPROVED
  POSTED
  VOIDED
}

// A payment allocation is immutable. Corrections are appended as an explicit
// adjustment and a reversal effect, never by mutating the original allocation.
// This first controlled flow is intentionally limited to records that are
// still APPROVED. POSTED facts require a later accounting-entry module.
enum FinancePaymentAllocationAdjustmentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  APPLIED
}

enum FinancePaymentAllocationEffectType {
  REVERSAL
}

// Marketing facts are intentionally kept separate from sales orders. Raw
// figures are captured once and calculated indicators are derived from the
// approved metric definitions, so teams cannot accidentally mix formulas.
enum MarketingReportStatus {
  DRAFT
  SUBMITTED
  RETURNED
  LOCKED
}

enum MarketingMetricValueType {
  COUNT
  MONEY_CENTS
  DECIMAL
  PERCENT
}

enum MarketingMetricAggregation {
  SUM
  AVG
  LAST
}

enum MarketingMetricCalculation {
  DIRECT
  RATIO
}

enum MarketingKpiScopeType {
  BUSINESS_UNIT
  DEPARTMENT
  MEMBERSHIP
}

enum MarketingCreativeAssetPurpose {
  PRIMARY
  SUPPORTING
  COPY_REFERENCE
}

model LegalEntity {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businessUnits                       BusinessUnit[]
  memberships                         Membership[]
  customers                           Customer[]
  products                            Product[]
  orders                              Order[]
  documents                           Document[]
  documentCategories                  DocumentCategory[]
  announcements                       Announcement[]
  attendanceRecords                   Attendance[]
  leaveRequests                       LeaveRequest[]
  expenses                            Expense[]
  auditLogs                           AuditLog[]
  shipments                           Shipment[]
  approvalRecords                     ApprovalRecord[]
  orderTemplates                      OrderTemplate[]
  orderNumberRules                    OrderNumberRule[]
  logisticsTemplates                  LogisticsProviderTemplate[]
  channelConnections                  ChannelConnection[]
  conversations                       Conversation[]
  inboxAuditEvents                    InboxAuditEvent[]
  attachments                         Attachment[]
  dailyGoals                          DailyGoal[]
  teamGoals                           TeamGoal[]
  logisticsExportBatches              LogisticsExportBatch[]
  logisticsReturnImportBatches        LogisticsReturnImportBatch[]
  logisticsBatchArtifacts             LogisticsBatchArtifact[]
  financeCounterparties               FinanceCounterparty[]
  financeStatements                   FinanceStatement[]
  financeReconciliations              FinanceReconciliation[]
  financePayments                     FinancePayment[]
  financePaymentAllocations           FinancePaymentAllocation[]
  financePaymentAllocationAdjustments FinancePaymentAllocationAdjustment[]
  financePaymentAllocationEffects     FinancePaymentAllocationEffect[]
  financeStatementTemplates           FinanceStatementTemplate[]
  financeStatementImportBatches       FinanceStatementImportBatch[]
  financeControlPolicies              FinanceControlPolicy[]
  resourceCategories                  ResourceCategory[]
  resourceStatuses                    ResourceStatus[]
  resourceLifecycleActions            ResourceLifecycleAction[]
  resourceAssets                      ResourceAsset[]
  resourceLifecycleEvents             ResourceLifecycleEvent[]
  marketingSources                    MarketingSource[]
  marketingMetricDefinitions          MarketingMetricDefinition[]
  marketingDailyReports               MarketingDailyReport[]
  marketingKpiTargets                 MarketingKpiTarget[]
  marketingCreativeStatuses           MarketingCreativeStatus[]
  marketingTags                       MarketingTag[]
  marketingCreatives                  MarketingCreative[]
  marketingWorkbenchSettings          MarketingWorkbenchSetting[]
}

model BusinessUnit {
  id            String   @id @default(uuid())
  legalEntityId String
  code          String
  name          String
  isActive      Boolean  @default(true)
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  legalEntity                         LegalEntity                          @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  departments                         Department[]
  sites                               Site[]
  memberships                         Membership[]
  auditLogs                           AuditLog[]
  accessGrants                        AccessGrant[]
  customers                           Customer[]
  products                            Product[]
  orders                              Order[]
  documents                           Document[]
  documentCategories                  DocumentCategory[]
  announcements                       Announcement[]
  attendance                          Attendance[]
  leaveRequests                       LeaveRequest[]
  expenses                            Expense[]
  shipments                           Shipment[]
  approvalRecords                     ApprovalRecord[]
  inventoryBalances                   InventoryBalance[]
  inventoryTransactions               InventoryTransaction[]
  inventoryReservations               InventoryReservation[]
  orderTemplates                      OrderTemplate[]
  orderNumberRules                    OrderNumberRule[]
  logisticsTemplates                  LogisticsProviderTemplate[]
  logisticsFollowUps                  LogisticsFollowUp[]
  logisticsEventAnnotations           LogisticsEventAnnotation[]
  logisticsWorkbenchSetting           LogisticsWorkbenchSetting?
  integrationCredentials              IntegrationCredential[]
  dashboardWorkbenchSetting           DashboardWorkbenchSetting?
  channelConnections                  ChannelConnection[]
  contactIdentities                   ContactIdentity[]
  conversations                       Conversation[]
  inboxTags                           InboxTag[]
  inboxAuditEvents                    InboxAuditEvent[]
  attachments                         Attachment[]
  dailyGoals                          DailyGoal[]
  teamGoals                           TeamGoal[]
  notificationDeliveries              NotificationDelivery[]
  logisticsExportBatches              LogisticsExportBatch[]
  logisticsReturnImportBatches        LogisticsReturnImportBatch[]
  logisticsBatchArtifacts             LogisticsBatchArtifact[]
  financeCounterparties               FinanceCounterparty[]
  financeStatements                   FinanceStatement[]
  financeReconciliations              FinanceReconciliation[]
  financePayments                     FinancePayment[]
  financePaymentAllocations           FinancePaymentAllocation[]
  financePaymentAllocationAdjustments FinancePaymentAllocationAdjustment[]
  financePaymentAllocationEffects     FinancePaymentAllocationEffect[]
  financeStatementTemplates           FinanceStatementTemplate[]
  financeStatementImportBatches       FinanceStatementImportBatch[]
  financeControlPolicy                FinanceControlPolicy?
  resourceCategories                  ResourceCategory[]
  resourceStatuses                    ResourceStatus[]
  resourceLifecycleActions            ResourceLifecycleAction[]
  resourceAssets                      ResourceAsset[]
  resourceLifecycleEvents             ResourceLifecycleEvent[]
  marketingSources                    MarketingSource[]
  marketingMetricDefinitions          MarketingMetricDefinition[]
  marketingDailyReports               MarketingDailyReport[]
  marketingKpiTargets                 MarketingKpiTarget[]
  marketingCreativeStatuses           MarketingCreativeStatus[]
  marketingTags                       MarketingTag[]
  marketingCreatives                  MarketingCreative[]
  marketingWorkbenchSetting           MarketingWorkbenchSetting?

  @@unique([legalEntityId, code])
  @@index([legalEntityId])
}

model Department {
  id             String   @id @default(uuid())
  businessUnitId String
  parentId       String?
  name           String
  code           String
  hierarchyPath  String?  @map("hierarchy_path")
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  businessUnit BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  parent       Department?  @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Department[] @relation("DepartmentTree")

  memberships                   Membership[]
  sites                         Site[]
  accessGrants                  AccessGrant[]
  customers                     Customer[]
  orders                        Order[]
  orderNumberRules              OrderNumberRule[]
  expenses                      Expense[]
  documents                     Document[]
  channelConnections            ChannelConnection[]
  conversations                 Conversation[]
  attachments                   Attachment[]
  teamGoals                     TeamGoal[]
  logisticsExportBatches        LogisticsExportBatch[]
  financeCounterparties         FinanceCounterparty[]
  financeStatements             FinanceStatement[]
  financePayments               FinancePayment[]
  financeStatementTemplates     FinanceStatementTemplate[]
  financeStatementImportBatches FinanceStatementImportBatch[]
  resourceAssets                ResourceAsset[]
  resourceLifecycleEvents       ResourceLifecycleEvent[]
  marketingSources              MarketingSource[]
  marketingDailyReports         MarketingDailyReport[]
  marketingKpiTargets           MarketingKpiTarget[]
  marketingCreatives            MarketingCreative[]

  @@unique([businessUnitId, code, parentId])
  @@index([businessUnitId, parentId])
}

model Site {
  id             String   @id @default(uuid())
  code           String
  name           String
  businessUnitId String
  departmentId   String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  businessUnit BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  memberships                   Membership[]
  accessGrants                  AccessGrant[]
  orders                        Order[]
  expenses                      Expense[]
  documents                     Document[]
  announcements                 Announcement[]
  attendance                    Attendance[]
  shipments                     Shipment[]
  inventoryBalances             InventoryBalance[]
  inventoryTransactions         InventoryTransaction[]
  inventoryReservations         InventoryReservation[]
  financeStatements             FinanceStatement[]
  financePayments               FinancePayment[]
  financeStatementImportBatches FinanceStatementImportBatch[]
  resourceAssets                ResourceAsset[]
  resourceLifecycleEvents       ResourceLifecycleEvent[]
  marketingSources              MarketingSource[]
  marketingDailyReports         MarketingDailyReport[]
  marketingCreatives            MarketingCreative[]

  @@unique([businessUnitId, code])
  @@index([departmentId])
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String   @unique
  fullName     String
  passwordHash String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships                       Membership[]
  auditLogs                         AuditLog[]
  orders                            Order[]                     @relation("OrderCreator")
  expenses                          Expense[]
  documents                         Document[]
  logisticsFollowUps                LogisticsFollowUp[]
  attendanceRecords                 Attendance[]
  inventoryTransactions             InventoryTransaction[]
  inboxAuditEvents                  InboxAuditEvent[]           @relation("InboxAuditActor")
  attachments                       Attachment[]                @relation("AttachmentUploader")
  marketingDailyReports             MarketingDailyReport[]      @relation("MarketingReportCreator")
  marketingCreatives                MarketingCreative[]         @relation("MarketingCreativeCreator")
  updatedMarketingWorkbenchSettings MarketingWorkbenchSetting[] @relation("MarketingWorkbenchSettingUpdater")
}

model Role {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships     Membership[]
  rolePermissions RolePermission[]
  menuPermissions MenuPermission[]
  delegationRules DelegationRule[] @relation("DelegationSourceRole")
}

model Action {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  namespace   String   @default("erp")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
  accessGrants    AccessGrant[]
  delegationRules DelegationRule[]
  requiredByMenus Menu[]           @relation("MenuRequiredAction")
}

model RolePermission {
  id         String   @id @default(uuid())
  roleId     String
  actionKey  String
  scope      String   @default("BUSINESS_UNIT")
  isAllowed  Boolean  @default(true)
  conditions Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  action Action @relation(fields: [actionKey], references: [key], onDelete: Cascade)

  @@unique([roleId, actionKey])
  @@index([roleId, scope])
}

model Menu {
  id                String   @id @default(uuid())
  key               String   @unique
  label             String
  path              String
  icon              String?
  parentId          String?
  sortOrder         Int      @default(0)
  isActive          Boolean  @default(true)
  requiredActionKey String?
  requiredCondition Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  parent         Menu?            @relation("MenuTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       Menu[]           @relation("MenuTree")
  requiredAction Action?          @relation("MenuRequiredAction", fields: [requiredActionKey], references: [key], onDelete: SetNull)
  grants         MenuPermission[]
}

model MenuPermission {
  id        String   @id @default(uuid())
  menuId    String
  roleId    String
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())

  menu Menu @relation(fields: [menuId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([menuId, roleId])
}

model Membership {
  id                  String    @id @default(uuid())
  userId              String
  businessUnitId      String
  departmentId        String?
  siteId              String?
  roleId              String
  managerMembershipId String?
  legalEntityId       String
  isPrimary           Boolean   @default(false)
  isActive            Boolean   @default(true)
  scope               String    @default("BUSINESS_UNIT")
  startedAt           DateTime  @default(now())
  endedAt             DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  legalEntity         LegalEntity  @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  businessUnit        BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  department          Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  site                Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)
  role                Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  managerMembership   Membership?  @relation("MembershipHierarchy", fields: [managerMembershipId], references: [id], onDelete: SetNull)
  directReports       Membership[] @relation("MembershipHierarchy")
  orders              Order[]      @relation("OrderOwner")
  claimedOrderReviews Order[]      @relation("OrderReviewClaim")
  shopWindowTransfers Order[]      @relation("OrderShopWindowTransfer")
  uploadedDocuments   Document[]   @relation("DocumentOwnerMembership")
  reviewedDocuments   Document[]   @relation("DocumentReviewer")

  grantedAccess  AccessGrant[] @relation("GrantedAccess")
  receivedAccess AccessGrant[] @relation("ReceivedAccess")

  actionAudits                                 AuditLog[]                           @relation("ActorMembership")
  submittedApprovals                           ApprovalRecord[]                     @relation("SubmittedApprovals")
  approvedApprovals                            ApprovalRecord[]                     @relation("ApprovedApprovals")
  attendanceRecords                            Attendance[]                         @relation("MembershipAttendance")
  leaveRequests                                LeaveRequest[]                       @relation("LeaveRequester")
  leaveApprovals                               LeaveRequest[]                       @relation("LeaveApprover")
  shipmentEvents                               ShipmentEvent[]                      @relation("MembershipShipmentEvents")
  ownedShipments                               Shipment[]                           @relation("ShipmentAftersalesOwner")
  logisticsFollowUps                           LogisticsFollowUp[]
  handledLogisticsAnnotations                  LogisticsEventAnnotation[]           @relation("LogisticsAnnotationHandler")
  inventoryTransactions                        InventoryTransaction[]
  assignedConversations                        ConversationAssignment[]             @relation("ConversationAssignee")
  conversationAssignmentsMade                  ConversationAssignment[]             @relation("ConversationAssigner")
  inboxAuditEvents                             InboxAuditEvent[]                    @relation("InboxAuditMembership")
  uploadedAttachments                          Attachment[]                         @relation("AttachmentUploaderMembership")
  dailyGoals                                   DailyGoal[]                          @relation("DailyGoalOwner")
  goalsSetForOthers                            DailyGoal[]                          @relation("DailyGoalSetter")
  teamGoalsSet                                 TeamGoal[]                           @relation("TeamGoalSetter")
  logisticsExportBatches                       LogisticsExportBatch[]               @relation("LogisticsExportBatchCreator")
  logisticsReturnImportBatches                 LogisticsReturnImportBatch[]         @relation("LogisticsReturnImportBatchPreviewer")
  logisticsBatchArtifacts                      LogisticsBatchArtifact[]             @relation("LogisticsBatchArtifactCreator")
  createdFinanceCounterparties                 FinanceCounterparty[]                @relation("FinanceCounterpartyCreator")
  createdFinanceStatements                     FinanceStatement[]                   @relation("FinanceStatementCreator")
  approvedFinanceStatements                    FinanceStatement[]                   @relation("FinanceStatementApprover")
  postedFinanceStatements                      FinanceStatement[]                   @relation("FinanceStatementPoster")
  voidedFinanceStatements                      FinanceStatement[]                   @relation("FinanceStatementVoider")
  createdFinanceReconciliations                FinanceReconciliation[]              @relation("FinanceReconciliationCreator")
  confirmedFinanceReconciliations              FinanceReconciliation[]              @relation("FinanceReconciliationConfirmer")
  voidedFinanceReconciliations                 FinanceReconciliation[]              @relation("FinanceReconciliationVoider")
  createdFinancePayments                       FinancePayment[]                     @relation("FinancePaymentCreator")
  approvedFinancePayments                      FinancePayment[]                     @relation("FinancePaymentApprover")
  postedFinancePayments                        FinancePayment[]                     @relation("FinancePaymentPoster")
  voidedFinancePayments                        FinancePayment[]                     @relation("FinancePaymentVoider")
  createdFinancePaymentAllocations             FinancePaymentAllocation[]           @relation("FinancePaymentAllocationCreator")
  requestedFinancePaymentAllocationAdjustments FinancePaymentAllocationAdjustment[] @relation("FinanceAllocationAdjustmentRequester")
  approvedFinancePaymentAllocationAdjustments  FinancePaymentAllocationAdjustment[] @relation("FinanceAllocationAdjustmentApprover")
  rejectedFinancePaymentAllocationAdjustments  FinancePaymentAllocationAdjustment[] @relation("FinanceAllocationAdjustmentRejecter")
  cancelledFinancePaymentAllocationAdjustments FinancePaymentAllocationAdjustment[] @relation("FinanceAllocationAdjustmentCanceller")
  appliedFinancePaymentAllocationAdjustments   FinancePaymentAllocationAdjustment[] @relation("FinanceAllocationAdjustmentApplier")
  appliedFinancePaymentAllocationEffects       FinancePaymentAllocationEffect[]     @relation("FinanceAllocationEffectApplier")
  createdFinanceStatementTemplates             FinanceStatementTemplate[]           @relation("FinanceStatementTemplateCreator")
  previewedFinanceStatementImportBatches       FinanceStatementImportBatch[]        @relation("FinanceStatementImportBatchPreviewer")
  confirmedFinanceStatementImportBatches       FinanceStatementImportBatch[]        @relation("FinanceStatementImportBatchConfirmer")
  cancelledFinanceStatementImportBatches       FinanceStatementImportBatch[]        @relation("FinanceStatementImportBatchCanceller")
  updatedFinanceControlPolicies                FinanceControlPolicy[]               @relation("FinanceControlPolicyUpdater")
  assignedResourceAssets                       ResourceAsset[]                      @relation("ResourceAssetAssignee")
  createdResourceAssets                        ResourceAsset[]                      @relation("ResourceAssetCreator")
  resourceLifecycleEvents                      ResourceLifecycleEvent[]             @relation("ResourceLifecycleActor")
  transferredFromResourceEvents                ResourceLifecycleEvent[]             @relation("ResourceLifecycleFromAssignee")
  transferredToResourceEvents                  ResourceLifecycleEvent[]             @relation("ResourceLifecycleToAssignee")
  marketingDailyReports                        MarketingDailyReport[]               @relation("MarketingReportOwner")
  reviewedMarketingDailyReports                MarketingDailyReport[]               @relation("MarketingReportReviewer")
  lockedMarketingDailyReports                  MarketingDailyReport[]               @relation("MarketingReportLocker")
  marketingKpiTargetsSet                       MarketingKpiTarget[]                 @relation("MarketingKpiTargetSetter")
  marketingKpiTargets                          MarketingKpiTarget[]                 @relation("MarketingKpiTargetMembership")
  marketingCreatives                           MarketingCreative[]                  @relation("MarketingCreativeOwner")

  @@index([userId, isActive])
  @@index([businessUnitId, isActive])
  @@index([legalEntityId])
  @@index([managerMembershipId, isActive])
}

model AccessGrant {
  id                  String    @id @default(uuid())
  granteeMembershipId String
  granterMembershipId String
  actionKey           String
  scope               String    @default("DEPARTMENT")
  reason              String
  businessUnitId      String
  departmentId        String?
  siteId              String?
  grantedAt           DateTime  @default(now())
  expiresAt           DateTime?
  revokedAt           DateTime?
  isActive            Boolean   @default(true)

  action            Action       @relation(fields: [actionKey], references: [key], onDelete: Cascade)
  granteeMembership Membership   @relation("ReceivedAccess", fields: [granteeMembershipId], references: [id], onDelete: Cascade)
  granterMembership Membership   @relation("GrantedAccess", fields: [granterMembershipId], references: [id], onDelete: Cascade)
  businessUnit      BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  department        Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  site              Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@index([granteeMembershipId, isActive])
  @@index([granterMembershipId, isActive])
  @@index([expiresAt])
  @@index([businessUnitId, isActive])
}

model DelegationRule {
  id          String   @id @default(uuid())
  roleId      String
  actionKey   String
  canTransfer Boolean  @default(false)
  maxScope    String   @default("DEPARTMENT")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  role   Role   @relation("DelegationSourceRole", fields: [roleId], references: [id], onDelete: Cascade)
  action Action @relation(fields: [actionKey], references: [key], onDelete: Cascade)

  @@unique([roleId, actionKey])
}

model AuditLog {
  id                String   @id @default(uuid())
  action            String
  actorUserId       String?
  actorMembershipId String?
  module            String
  targetType        String
  targetId          String?
  legalEntityId     String?
  businessUnitId    String?
  roleId            String?
  details           Json?
  ipAddress         String?
  createdAt         DateTime @default(now())

  actorUser       User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorMembership Membership?   @relation("ActorMembership", fields: [actorMembershipId], references: [id], onDelete: SetNull)
  legalEntity     LegalEntity?  @relation(fields: [legalEntityId], references: [id], onDelete: SetNull)
  businessUnit    BusinessUnit? @relation(fields: [businessUnitId], references: [id], onDelete: SetNull)
}

model Customer {
  id             String   @id @default(uuid())
  legalEntityId  String
  businessUnitId String
  departmentId   String?
  code           String
  name           String
  contactName    String?
  contactPhone   String?
  contactEmail   String?
  taxId          String?
  address        String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  legalEntity       LegalEntity                @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  businessUnit      BusinessUnit               @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  department        Department?                @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  orders            Order[]
  conversationLinks ConversationCustomerLink[]

  @@unique([businessUnitId, code])
  @@index([legalEntityId, businessUnitId])
}

model Product {
  id             String   @id @default(uuid())
  legalEntityId  String
  businessUnitId String
  code           String
  name           String
  description    String?
  category       String?
  unit           String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  legalEntity           LegalEntity            @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  businessUnit          BusinessUnit           @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  skus                  ProductSku[]
  orderItems            OrderItem[]
  marketingDailyReports MarketingDailyReport[]
  marketingCreatives    MarketingCreative[]

  @@unique([businessUnitId, code])
  @@index([legalEntityId])
}

model ProductSku {
  id                  String   @id @default(uuid())
  productId           String
  code                String
  barcode             String?
  attributes          Json?
  safetyStockQuantity Int      @default(0)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  product               Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems            OrderItem[]
  inventoryBalances     InventoryBalance[]
  inventoryTransactions InventoryTransaction[]
  inventoryReservations InventoryReservation[]

  @@unique([productId, code])
  @@index([productId])
}

model Order {
  id                                  String      @id @default(uuid())
  legalEntityId                       String
  businessUnitId                      String
  departmentId                        String?
  siteId                              String?
  customerId                          String
  orderNo                             String
  creatorUserId                       String
  ownedByMembershipId                 String
  shopId                              String?
  orderTemplateId                     String?
  orderNumberRuleId                   String?
  status                              OrderStatus @default(DRAFT)
  currency                            String      @default("CNY")
  declarationCurrency                 String      @default("EUR")
  productValueCents                   Int         @default(0)
  shippingFeeCents                    Int         @default(0)
  codAmountCents                      Int         @default(0)
  paidAmountCents                     Int         @default(0)
  logisticsChannel                    String?
  recipientName                       String?
  recipientPhone                      String?
  recipientEmail                      String?
  emailValidationStatus               String?
  emailValidatedAt                    DateTime?
  recipientCountryCode                String?
  recipientPostalCode                 String?
  recipientRegion                     String?
  recipientCity                       String?
  recipientAddress                    String?
  packageWeightGrams                  Int?
  paymentMethod                       String?
  customerWhatsapp                    String?
  staffWhatsapp                       String?
  orderedAt                           DateTime    @default(now())
  note                                String?
  exceptionNote                       String?
  customFields                        Json?
  templateSnapshot                    Json?
  deliveredAt                         DateTime?
  reviewClaimedByMembershipId         String?
  reviewClaimedAt                     DateTime?
  shopWindowTransferredAt             DateTime?
  shopWindowTransferredByMembershipId String?
  createdAt                           DateTime    @default(now())
  updatedAt                           DateTime    @updatedAt

  legalEntity               LegalEntity                @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  businessUnit              BusinessUnit               @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  department                Department?                @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  site                      Site?                      @relation(fields: [siteId], references: [id], onDelete: SetNull)
  customer                  Customer                   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  creatorUser               User                       @relation("OrderCreator", fields: [creatorUserId], references: [id], onDelete: Restrict)
  ownerMembership           Membership                 @relation("OrderOwner", fields: [ownedByMembershipId], references: [id], onDelete: Restrict)
  reviewClaimedBy           Membership?                @relation("OrderReviewClaim", fields: [reviewClaimedByMembershipId], references: [id], onDelete: SetNull)
  shopWindowTransferredBy   Membership?                @relation("OrderShopWindowTransfer", fields: [shopWindowTransferredByMembershipId], references: [id], onDelete: SetNull)
  orderTemplate             OrderTemplate?             @relation(fields: [orderTemplateId], references: [id], onDelete: SetNull)
  orderNumberRule           OrderNumberRule?           @relation(fields: [orderNumberRuleId], references: [id], onDelete: SetNull)
  items                     OrderItem[]
  shipments                 Shipment[]
  expenses                  Expense[]
  inventoryTransactions     InventoryTransaction[]
  inventoryReservations     InventoryReservation[]
  logisticsExportBatchItems LogisticsExportBatchItem[]
  financeStatementLines     FinanceStatementLine[]
  financeReconciliations    FinanceReconciliation[]

  @@unique([businessUnitId, orderNo])
  @@index([legalEntityId, businessUnitId])
  @@index([businessUnitId, shopId])
  @@index([customerId, status])
  @@index([orderTemplateId])
  @@index([orderNumberRuleId])
  @@index([businessUnitId, recipientEmail])
  @@index([businessUnitId, status, reviewClaimedByMembershipId])
  @@index([businessUnitId, shopWindowTransferredAt])
  @@index([businessUnitId, departmentId, creatorUserId, createdAt])
  @@index([businessUnitId, ownedByMembershipId, createdAt, id])
  @@index([businessUnitId, recipientCountryCode])
}

model OrderTemplate {
  id             String   @id @default(uuid())
  legalEntityId  String
  businessUnitId String
  code           String
  name           String
  description    String?
  configuration  Json
  isDefault      Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  legalEntity      LegalEntity       @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  businessUnit     BusinessUnit      @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  orders           Order[]
  orderNumberRules OrderNumberRule[]

  @@unique([businessUnitId, code])
  @@index([businessUnitId, isActive])
}

// Order number formatting is a business configuration, never a role, business-unit,
// or department name hard-coded into application logic. A rule can optionally target
// one department or one order template. Matching chooses the most specific active rule.
model OrderNumberRule {
  id                    String   @id @default(uuid())
  legalEntityId         String
  businessUnitId        String
  departmentId          String?
  orderTemplateId       String?
  code                  String
  name                  String
  prefix                String   @default("")
  dateFormat            String   @default("YYYYMMDD")
  timeZone              String   @default("UTC")
  includeDepartmentCode Boolean  @default(false)
  separator             String   @default("-")
  sequencePadding       Int      @default(1)
  resetPeriod           String   @default("DAILY")
  priority              Int      @default(0)
  isDefault             Boolean  @default(false)
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  legalEntity   LegalEntity          @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  businessUnit  BusinessUnit         @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  department    Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  orderTemplate OrderTemplate?       @relation(fields: [orderTemplateId], references: [id], onDelete: SetNull)
  counters      OrderNumberCounter[]
  orders        Order[]

  @@unique([businessUnitId, code])
  @@index([businessUnitId, isActive, priority])
  @@index([businessUnitId, departmentId, orderTemplateId])
}

// The counter is isolated by rule, reset period, and optional department scope.
// PostgreSQL upsert increments this row atomically, so concurrent order creation
// cannot produce duplicate sequence values.
model OrderNumberCounter {
  id        String   @id @default(uuid())
  ruleId    String
  periodKey String
  scopeKey  String   @default("GLOBAL")
  lastValue Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rule OrderNumberRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, periodKey, scopeKey])
  @@index([ruleId, updatedAt])
}

model LogisticsProviderTemplate {
  id             String    @id @default(uuid())
  legalEntityId  String
  businessUnitId String
  code           String
  name           String
  carrierName    String
  configuration  Json
  version        Int       @default(1)
  isActive       Boolean   @default(true)
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  legalEntity   LegalEntity            @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  businessUnit  BusinessUnit           @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  exportBatches LogisticsExportBatch[]

  @@unique([businessUnitId, code])
  @@index([businessUnitId, archivedAt, isActive])
}

model LogisticsExportBatch {
  id                    String                     @id @default(uuid())
  legalEntityId         String
  businessUnitId        String
  departmentId          String?
  templateId            String
  templateVersion       Int
  batchNo               String
  templateSnapshot      Json
  orderCount            Int
  status                LogisticsExportBatchStatus @default(EXPORTED)
  dispatchNote          String?
  dispatchedAt          DateTime?
  createdByMembershipId String
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  legalEntity         LegalEntity                  @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  businessUnit        BusinessUnit                 @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  department          Department?                  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  template            LogisticsProviderTemplate    @relation(fields: [templateId], references: [id], onDelete: Restrict)
  createdByMembership Membership                   @relation("LogisticsExportBatchCreator", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  items               LogisticsExportBatchItem[]
  returnImports       LogisticsReturnImportBatch[]
  artifacts           LogisticsBatchArtifact[]

  @@unique([businessUnitId, batchNo])
  @@index([businessUnitId, status, createdAt])
  @@index([departmentId, createdAt])
  @@index([createdByMembershipId, createdAt])
}

model LogisticsExportBatchItem {
  id              String    @id @default(uuid())
  exportBatchId   String
  orderId         String
  orderNoSnapshot String
  rowHash         String
  payloadSnapshot Json
  trackingNo      String?
  importedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  exportBatch LogisticsExportBatch @relation(fields: [exportBatchId], references: [id], onDelete: Cascade)
  order       Order                @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([exportBatchId, orderId])
  @@index([orderId])
  @@index([exportBatchId, orderNoSnapshot])
}

model LogisticsReturnImportBatch {
  id                      String                           @id @default(uuid())
  legalEntityId           String
  businessUnitId          String
  exportBatchId           String
  originalName            String
  storageKey              String
  mimeType                String
  sizeBytes               Int
  sha256                  String
  mappingSnapshot         Json
  totalRows               Int
  readyRows               Int
  warningRows             Int
  rejectedRows            Int
  importedRows            Int                              @default(0)
  status                  LogisticsReturnImportBatchStatus @default(PREVIEWED)
  previewedByMembershipId String
  previewedAt             DateTime                         @default(now())
  importedAt              DateTime?
  createdAt               DateTime                         @default(now())
  updatedAt               DateTime                         @updatedAt

  legalEntity           LegalEntity                @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  businessUnit          BusinessUnit               @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  exportBatch           LogisticsExportBatch       @relation(fields: [exportBatchId], references: [id], onDelete: Restrict)
  previewedByMembership Membership                 @relation("LogisticsReturnImportBatchPreviewer", fields: [previewedByMembershipId], references: [id], onDelete: Restrict)
  rows                  LogisticsReturnImportRow[]
  artifacts             LogisticsBatchArtifact[]

  @@unique([exportBatchId, sha256])
  @@index([businessUnitId, status, previewedAt])
  @@index([exportBatchId, status])
  @@index([sha256])
}

model LogisticsReturnImportRow {
  id             String                         @id @default(uuid())
  importBatchId  String
  rowNumber      Int
  orderNo        String
  trackingNo     String
  carrier        String?
  providerStatus String?
  sourceRowHash  String
  orderId        String?
  shipmentId     String?
  status         LogisticsReturnImportRowStatus
  message        String
  importedAt     DateTime?
  createdAt      DateTime                       @default(now())
  updatedAt      DateTime                       @updatedAt

  importBatch LogisticsReturnImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)

  @@unique([importBatchId, rowNumber])
  @@index([importBatchId, status])
  @@index([orderId])
  @@index([shipmentId])
}

model LogisticsBatchArtifact {
  id                    String                     @id @default(uuid())
  legalEntityId         String
  businessUnitId        String
  exportBatchId         String?
  returnImportBatchId   String?
  kind                  LogisticsBatchArtifactKind
  originalName          String
  storageKey            String
  mimeType              String
  sizeBytes             Int
  sha256                String
  createdByMembershipId String
  createdAt             DateTime                   @default(now())

  legalEntity         LegalEntity                 @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  businessUnit        BusinessUnit                @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  exportBatch         LogisticsExportBatch?       @relation(fields: [exportBatchId], references: [id], onDelete: Cascade)
  returnImportBatch   LogisticsReturnImportBatch? @relation(fields: [returnImportBatchId], references: [id], onDelete: Cascade)
  createdByMembership Membership                  @relation("LogisticsBatchArtifactCreator", fields: [createdByMembershipId], references: [id], onDelete: Restrict)

  @@unique([businessUnitId, storageKey])
  @@index([businessUnitId, createdAt])
  @@index([exportBatchId])
  @@index([returnImportBatchId])
}

model InventoryBalance {
  id               String   @id @default(uuid())
  businessUnitId   String
  siteId           String
  skuId            String
  onHandQuantity   Int      @default(0)
  reservedQuantity Int      @default(0)
  version          Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  businessUnit BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  site         Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  sku          ProductSku   @relation(fields: [skuId], references: [id], onDelete: Restrict)

  @@unique([businessUnitId, siteId, skuId])
  @@index([skuId, siteId])
}

model InventoryTransaction {
  id                String                   @id @default(uuid())
  businessUnitId    String
  siteId            String
  skuId             String
  orderId           String?
  actorUserId       String
  actorMembershipId String
  type              InventoryTransactionType
  quantityDelta     Int
  onHandAfter       Int
  reservedAfter     Int
  idempotencyKey    String
  reason            String?
  createdAt         DateTime                 @default(now())

  businessUnit    BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  site            Site         @relation(fields: [siteId], references: [id], onDelete: Restrict)
  sku             ProductSku   @relation(fields: [skuId], references: [id], onDelete: Restrict)
  order           Order?       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  actorUser       User         @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  actorMembership Membership   @relation(fields: [actorMembershipId], references: [id], onDelete: Restrict)

  @@unique([businessUnitId, idempotencyKey])
  @@index([businessUnitId, siteId, skuId, createdAt])
  @@index([orderId])
}

model InventoryReservation {
  id             String                     @id @default(uuid())
  businessUnitId String
  siteId         String
  skuId          String
  orderId        String
  quantity       Int
  status         InventoryReservationStatus @default(ACTIVE)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  businessUnit BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  site         Site         @relation(fields: [siteId], references: [id], onDelete: Restrict)
  sku          ProductSku   @relation(fields: [skuId], references: [id], onDelete: Restrict)
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([orderId, skuId, siteId])
  @@index([businessUnitId, siteId, status])
}

model OrderItem {
  id              String  @id @default(uuid())
  orderId         String
  productId       String?
  skuId           String?
  stockControlled Boolean @default(true)
  productName     String
  quantity        Int
  unitPriceCents  Int
  subtotalCents   Int

  order   Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  sku     ProductSku? @relation(fields: [skuId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model Shipment {
  id                  String                  @id @default(uuid())
  orderId             String
  legalEntityId       String
  businessUnitId      String
  siteId              String?
  carrier             String?
  trackingNo          String?
  status              ShipmentStatus          @default(PENDING)
  shippedAt           DateTime?
  deliveredAt         DateTime?
  exceptionReason     String?
  exceptionSeverity   LogisticsIssueSeverity?
  workStatus          LogisticsWorkStatus     @default(MONITORING)
  ownerMembershipId   String?
  firstTrackedAt      DateTime?
  lastTrackedAt       DateTime?
  estimatedDeliveryAt DateTime?
  nextFollowUpAt      DateTime?
  closedAt            DateTime?
  closeReason         String?
  memo                String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  order                  Order                      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  legalEntity            LegalEntity                @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  businessUnit           BusinessUnit               @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  site                   Site?                      @relation(fields: [siteId], references: [id], onDelete: SetNull)
  ownerMembership        Membership?                @relation("ShipmentAftersalesOwner", fields: [ownerMembershipId], references: [id], onDelete: SetNull)
  events                 ShipmentEvent[]
  followUps              LogisticsFollowUp[]
  eventAnnotations       LogisticsEventAnnotation[]
  notificationDeliveries NotificationDelivery[]
  financeStatementLines  FinanceStatementLine[]
  financeReconciliations FinanceReconciliation[]

  @@unique([businessUnitId, trackingNo])
  @@index([orderId, status])
  @@index([businessUnitId, workStatus, nextFollowUpAt])
  @@index([ownerMembershipId, workStatus])
  @@index([businessUnitId, status, createdAt, id])
  @@index([businessUnitId, ownerMembershipId, createdAt, id])
}

model ShipmentEvent {
  id                String   @id @default(uuid())
  shipmentId        String
  occurredAt        DateTime @default(now())
  eventType         String
  statusMilestone   String?
  location          String?
  source            String   @default("MANUAL")
  externalEventKey  String?
  memo              String?
  actorMembershipId String?

  shipment               Shipment                  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  actorMembership        Membership?               @relation("MembershipShipmentEvents", fields: [actorMembershipId], references: [id], onDelete: SetNull)
  annotation             LogisticsEventAnnotation?
  notificationDeliveries NotificationDelivery[]

  @@unique([shipmentId, source, externalEventKey])
  @@index([shipmentId, occurredAt])
  @@index([shipmentId, occurredAt, id])
  @@index([shipmentId, eventType, occurredAt])
}

model LogisticsEventAnnotation {
  id                    String    @id @default(uuid())
  shipmentId            String
  shipmentEventId       String    @unique
  businessUnitId        String
  note                  String?
  tags                  String[]  @default([])
  isHandled             Boolean   @default(false)
  handledAt             DateTime?
  handledByMembershipId String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  shipment            Shipment      @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  shipmentEvent       ShipmentEvent @relation(fields: [shipmentEventId], references: [id], onDelete: Cascade)
  businessUnit        BusinessUnit  @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  handledByMembership Membership?   @relation("LogisticsAnnotationHandler", fields: [handledByMembershipId], references: [id], onDelete: SetNull)

  @@index([businessUnitId, isHandled, updatedAt])
  @@index([shipmentId, updatedAt])
}

model LogisticsFollowUp {
  id                String               @id @default(uuid())
  shipmentId        String
  businessUnitId    String
  actorUserId       String
  actorMembershipId String
  actionType        String
  fromStatus        LogisticsWorkStatus?
  toStatus          LogisticsWorkStatus?
  note              String?
  nextFollowUpAt    DateTime?
  createdAt         DateTime             @default(now())

  shipment        Shipment     @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  businessUnit    BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  actorUser       User         @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  actorMembership Membership   @relation(fields: [actorMembershipId], references: [id], onDelete: Restrict)

  @@index([shipmentId, createdAt])
  @@index([businessUnitId, toStatus, createdAt])
}

model LogisticsWorkbenchSetting {
  id                         String   @id @default(uuid())
  businessUnitId             String   @unique
  quickTags                  String[] @default([])
  cards                      Json
  alertRules                 Json     @default("[]")
  syncIntervalMinutes        Int      @default(30)
  feishuNotificationsEnabled Boolean  @default(false)
  feishuHighPriorityOnly     Boolean  @default(true)
  closeOrderPinHash          String?
  updatedByUserId            String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  businessUnit BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
}

// Third-party credentials are encrypted as one authenticated payload. Raw
// values are never stored in JSON configuration columns or audit records.
model IntegrationCredential {
  id               String   @id @default(uuid())
  businessUnitId   String
  providerKey      String
  encryptedPayload String
  isEnabled        Boolean  @default(false)
  updatedByUserId  String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  businessUnit BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)

  @@unique([businessUnitId, providerKey])
  @@index([businessUnitId, isEnabled])
}

model TrackingTranslation {
  id             String   @id @default(uuid())
  businessUnitId String
  sourceHash     String
  sourceText     String
  translatedText String
  sourceLanguage String?
  provider       String   @default("GOOGLE_TRANSLATE")
  useCount       Int      @default(1)
  lastUsedAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([businessUnitId, sourceHash])
  @@index([businessUnitId, lastUsedAt])
}

// Dashboard cards are business-unit configuration, not a hard-coded role
// dashboard. Card audience, placement, labels and visibility are all stored
// as validated JSON so the same engine can serve new departments and roles.
model DashboardWorkbenchSetting {
  id              String   @id @default(uuid())
  businessUnitId  String   @unique
  cards           Json
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  businessUnit BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
}

model NotificationDelivery {
  id                String                     @id @default(uuid())
  businessUnitId    String
  shipmentId        String?
  shipmentEventId   String?
  channel           String
  eventType         String
  dedupeKey         String                     @unique
  status            NotificationDeliveryStatus @default(PENDING)
  attempts          Int                        @default(0)
  nextAttemptAt     DateTime                   @default(now())
  lockedAt          DateTime?
  lastError         String?
  providerMessageId String?
  sentAt            DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  businessUnit  BusinessUnit   @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  shipment      Shipment?      @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  shipmentEvent ShipmentEvent? @relation(fields: [shipmentEventId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([businessUnitId, channel, status])
  @@index([shipmentId, createdAt])
}

model FinanceCounterparty {
  id                    String                  @id @default(uuid())
  legalEntityId         String
  businessUnitId        String
  departmentId          String?
  code                  String
  name                  String
  type                  FinanceCounterpartyType
  isActive              Boolean                 @default(true)
  metadata              Json?
  createdByMembershipId String
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  legalEntity            LegalEntity                   @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  businessUnit           BusinessUnit                  @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  department             Department?                   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdByMembership    Membership                    @relation("FinanceCounterpartyCreator", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  statements             FinanceStatement[]
  reconciliations        FinanceReconciliation[]
  payments               FinancePayment[]
  statementTemplates     FinanceStatementTemplate[]
  statementImportBatches FinanceStatementImportBatch[]

  @@unique([businessUnitId, code])
  @@index([businessUnitId, isActive, name])
  @@index([departmentId, isActive])
  @@index([createdByMembershipId, createdAt])
}

model FinanceStatement {
  id                     String                 @id @default(uuid())
  legalEntityId          String
  businessUnitId         String
  departmentId           String?
  siteId                 String?
  counterpartyId         String
  statementNo            String
  type                   FinanceStatementType
  status                 FinanceStatementStatus @default(DRAFT)
  currency               String
  currencyScale          Int                    @default(2)
  totalAmountCents       BigInt
  periodStart            DateTime?
  periodEnd              DateTime?
  issuedAt               DateTime?
  confirmedAt            DateTime?
  approvedAt             DateTime?
  postedAt               DateTime?
  voidedAt               DateTime?
  externalReference      String?
  note                   String?
  exceptionReason        String?
  createdByMembershipId  String
  approvedByMembershipId String?
  postedByMembershipId   String?
  voidedByMembershipId   String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  legalEntity                      LegalEntity                          @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  businessUnit                     BusinessUnit                         @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  department                       Department?                          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  site                             Site?                                @relation(fields: [siteId], references: [id], onDelete: SetNull)
  counterparty                     FinanceCounterparty                  @relation(fields: [counterpartyId], references: [id], onDelete: Restrict)
  createdByMembership              Membership                           @relation("FinanceStatementCreator", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  approvedByMembership             Membership?                          @relation("FinanceStatementApprover", fields: [approvedByMembershipId], references: [id], onDelete: SetNull)
  postedByMembership               Membership?                          @relation("FinanceStatementPoster", fields: [postedByMembershipId], references: [id], onDelete: SetNull)
  voidedByMembership               Membership?                          @relation("FinanceStatementVoider", fields: [voidedByMembershipId], references: [id], onDelete: SetNull)
  lines                            FinanceStatementLine[]
  paymentAllocations               FinancePaymentAllocation[]
  replacementAllocationAdjustments FinancePaymentAllocationAdjustment[] @relation("FinanceAllocationAdjustmentReplacementStatement")
  importSheet                      FinanceStatementImportSheet?         @relation("FinanceImportSheetStatement")

  @@unique([businessUnitId, counterpartyId, statementNo])
  @@index([businessUnitId, status, createdAt, id])
  @@index([businessUnitId, type, periodStart, periodEnd])
  @@index([departmentId, status, createdAt])
  @@index([counterpartyId, status])
}

model FinanceStatementLine {
  id                   String                          @id @default(uuid())
  statementId          String
  lineNo               Int
  orderId              String?
  shipmentId           String?
  sourceReference      String?
  description          String?
  currency             String
  currencyScale        Int                             @default(2)
  amountCents          BigInt
  reconciliationStatus FinanceLineReconciliationStatus @default(UNMATCHED)
  exceptionReason      String?
  sourceSnapshot       Json?
  createdAt            DateTime                        @default(now())
  updatedAt            DateTime                        @updatedAt

  statement       FinanceStatement        @relation(fields: [statementId], references: [id], onDelete: Restrict)
  order           Order?                  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  shipment        Shipment?               @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  reconciliations FinanceReconciliation[]

  @@unique([statementId, lineNo])
  @@index([statementId, reconciliationStatus, lineNo])
  @@index([orderId])
  @@index([shipmentId])
}

// A template is configuration data, not executable code. It describes
// permitted workbook sheets, header aliases and field mappings. New partners
// or workbook variants are added by configuration rather than code branches.
model FinanceStatementTemplate {
  id                    String   @id @default(uuid())
  legalEntityId         String
  businessUnitId        String
  departmentId          String?
  counterpartyId        String?
  code                  String
  name                  String
  description           String?
  configuration         Json
  version               Int      @default(1)
  isActive              Boolean  @default(true)
  createdByMembershipId String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  legalEntity         LegalEntity                   @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  businessUnit        BusinessUnit                  @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  department          Department?                   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  counterparty        FinanceCounterparty?          @relation(fields: [counterpartyId], references: [id], onDelete: Restrict)
  createdByMembership Membership                    @relation("FinanceStatementTemplateCreator", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  importBatches       FinanceStatementImportBatch[]

  @@unique([businessUnitId, code])
  @@index([businessUnitId, isActive, createdAt])
  @@index([departmentId, isActive])
  @@index([counterpartyId, isActive])
  @@index([createdByMembershipId, createdAt])
}

// This is the private, immutable staging record for a workbook. Confirming a
// batch is the only operation that creates FinanceStatement rows.
model FinanceStatementImportBatch {
  id                      String                            @id @default(uuid())
  legalEntityId           String
  businessUnitId          String
  departmentId            String?
  siteId                  String?
  templateId              String
  templateVersion         Int
  templateSnapshot        Json
  counterpartyId          String
  statementNoPrefix       String
  externalReference       String?
  periodStart             DateTime?
  periodEnd               DateTime?
  issuedAt                DateTime?
  originalName            String
  storageKey              String
  mimeType                String
  sizeBytes               Int
  sha256                  String
  status                  FinanceStatementImportBatchStatus @default(PREVIEWED)
  totalRows               Int                               @default(0)
  readyRows               Int                               @default(0)
  warningRows             Int                               @default(0)
  rejectedRows            Int                               @default(0)
  importedRows            Int                               @default(0)
  previewedByMembershipId String
  previewedAt             DateTime                          @default(now())
  confirmedByMembershipId String?
  confirmedAt             DateTime?
  cancelledByMembershipId String?
  cancelledAt             DateTime?
  cancellationReason      String?
  createdAt               DateTime                          @default(now())
  updatedAt               DateTime                          @updatedAt

  legalEntity           LegalEntity                   @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  businessUnit          BusinessUnit                  @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  department            Department?                   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  site                  Site?                         @relation(fields: [siteId], references: [id], onDelete: SetNull)
  template              FinanceStatementTemplate      @relation(fields: [templateId], references: [id], onDelete: Restrict)
  counterparty          FinanceCounterparty           @relation(fields: [counterpartyId], references: [id], onDelete: Restrict)
  previewedByMembership Membership                    @relation("FinanceStatementImportBatchPreviewer", fields: [previewedByMembershipId], references: [id], onDelete: Restrict)
  confirmedByMembership Membership?                   @relation("FinanceStatementImportBatchConfirmer", fields: [confirmedByMembershipId], references: [id], onDelete: SetNull)
  cancelledByMembership Membership?                   @relation("FinanceStatementImportBatchCanceller", fields: [cancelledByMembershipId], references: [id], onDelete: SetNull)
  sheets                FinanceStatementImportSheet[]

  @@index([businessUnitId, status, previewedAt, id])
  @@index([departmentId, status, previewedAt])
  @@index([counterpartyId, status])
  @@index([templateId, createdAt])
  @@index([previewedByMembershipId, previewedAt])
  @@index([businessUnitId, status, cancelledAt])
}

// A single workbook can contain multiple configured financial sheets. Each
// sheet becomes at most one DRAFT FinanceStatement during confirmation.
model FinanceStatementImportSheet {
  id                 String               @id @default(uuid())
  importBatchId      String
  sheetKey           String
  sheetName          String
  headerRowNumber    Int
  statementNo        String
  statementType      FinanceStatementType
  currency           String
  currencyScale      Int                  @default(2)
  totalAmountCents   BigInt
  totalRows          Int                  @default(0)
  readyRows          Int                  @default(0)
  warningRows        Int                  @default(0)
  rejectedRows       Int                  @default(0)
  importedRows       Int                  @default(0)
  createdStatementId String?              @unique
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  importBatch      FinanceStatementImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Restrict)
  createdStatement FinanceStatement?           @relation("FinanceImportSheetStatement", fields: [createdStatementId], references: [id], onDelete: Restrict)
  rows             FinanceStatementImportRow[]

  @@unique([importBatchId, sheetKey])
  @@unique([importBatchId, statementNo])
  @@index([importBatchId, createdAt])
}

model FinanceStatementImportRow {
  id                String                          @id @default(uuid())
  importSheetId     String
  rowNumber         Int
  sourceRowHash     String
  status            FinanceStatementImportRowStatus @default(READY)
  issueCodes        Json?
  message           String?
  sourceReference   String?
  trackingReference String?
  description       String?
  currency          String?
  currencyScale     Int?
  amountCents       BigInt?
  sourceSnapshot    Json?
  importedAt        DateTime?
  createdAt         DateTime                        @default(now())
  updatedAt         DateTime                        @updatedAt

  importSheet FinanceStatementImportSheet @relation(fields: [importSheetId], references: [id], onDelete: Restrict)

  @@unique([importSheetId, rowNumber])
  @@index([importSheetId, status, rowNumber])
  @@index([sourceReference])
  @@index([trackingReference])
}

model FinanceReconciliation {
  id                      String                      @id @default(uuid())
  legalEntityId           String
  businessUnitId          String
  counterpartyId          String
  statementType           FinanceStatementType
  statementLineId         String
  orderId                 String?
  shipmentId              String?
  amountCents             BigInt
  status                  FinanceReconciliationStatus @default(SUGGESTED)
  method                  FinanceMatchMethod          @default(MANUAL)
  reason                  String?
  createdByMembershipId   String
  confirmedByMembershipId String?
  confirmedAt             DateTime?
  voidedByMembershipId    String?
  voidedAt                DateTime?
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt

  legalEntity           LegalEntity          @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  businessUnit          BusinessUnit         @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  counterparty          FinanceCounterparty  @relation(fields: [counterpartyId], references: [id], onDelete: Restrict)
  statementLine         FinanceStatementLine @relation(fields: [statementLineId], references: [id], onDelete: Restrict)
  order                 Order?               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  shipment              Shipment?            @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  createdByMembership   Membership           @relation("FinanceReconciliationCreator", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  confirmedByMembership Membership?          @relation("FinanceReconciliationConfirmer", fields: [confirmedByMembershipId], references: [id], onDelete: SetNull)
  voidedByMembership    Membership?          @relation("FinanceReconciliationVoider", fields: [voidedByMembershipId], references: [id], onDelete: SetNull)

  @@unique([statementLineId, orderId])
  @@unique([statementLineId, shipmentId])
  @@index([statementLineId, status])
  @@index([businessUnitId, counterpartyId, statementType, status])
  @@index([orderId, status])
  @@index([shipmentId, status])
}

model FinancePayment {
  id                     String                  @id @default(uuid())
  legalEntityId          String
  businessUnitId         String
  departmentId           String?
  siteId                 String?
  counterpartyId         String
  paymentNo              String
  direction              FinancePaymentDirection
  status                 FinancePaymentStatus    @default(DRAFT)
  currency               String
  currencyScale          Int                     @default(2)
  amountCents            BigInt
  paidAt                 DateTime?
  approvedAt             DateTime?
  postedAt               DateTime?
  voidedAt               DateTime?
  externalReference      String?
  note                   String?
  voidReason             String?
  createdByMembershipId  String
  approvedByMembershipId String?
  postedByMembershipId   String?
  voidedByMembershipId   String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  legalEntity          LegalEntity                @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  businessUnit         BusinessUnit               @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  department           Department?                @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  site                 Site?                      @relation(fields: [siteId], references: [id], onDelete: SetNull)
  counterparty         FinanceCounterparty        @relation(fields: [counterpartyId], references: [id], onDelete: Restrict)
  createdByMembership  Membership                 @relation("FinancePaymentCreator", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  approvedByMembership Membership?                @relation("FinancePaymentApprover", fields: [approvedByMembershipId], references: [id], onDelete: SetNull)
  postedByMembership   Membership?                @relation("FinancePaymentPoster", fields: [postedByMembershipId], references: [id], onDelete: SetNull)
  voidedByMembership   Membership?                @relation("FinancePaymentVoider", fields: [voidedByMembershipId], references: [id], onDelete: SetNull)
  allocations          FinancePaymentAllocation[]

  @@unique([businessUnitId, paymentNo])
  @@index([businessUnitId, status, createdAt, id])
  @@index([departmentId, status, createdAt])
  @@index([counterpartyId, status])
}

model FinancePaymentAllocation {
  id                    String   @id @default(uuid())
  legalEntityId         String
  businessUnitId        String
  paymentId             String
  statementId           String
  // A client-generated key makes an allocation request safe to retry without
  // turning a network timeout into a second financial allocation.
  idempotencyKey        String
  amountCents           BigInt
  createdByMembershipId String
  createdAt             DateTime @default(now())

  legalEntity               LegalEntity                          @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  businessUnit              BusinessUnit                         @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  payment                   FinancePayment                       @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  statement                 FinanceStatement                     @relation(fields: [statementId], references: [id], onDelete: Restrict)
  createdByMembership       Membership                           @relation("FinancePaymentAllocationCreator", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  effects                   FinancePaymentAllocationEffect[]     @relation("FinancePaymentAllocationEffects")
  sourceAdjustments         FinancePaymentAllocationAdjustment[] @relation("FinanceAllocationAdjustmentSource")
  replacementForAdjustments FinancePaymentAllocationAdjustment[] @relation("FinanceAllocationAdjustmentReplacement")

  @@unique([paymentId, idempotencyKey])
  @@index([legalEntityId, businessUnitId])
  @@index([paymentId, statementId, createdAt])
  @@index([statementId, createdAt])
  @@index([createdByMembershipId, createdAt])
}

// A four-eye request to move one whole APPROVED allocation to another
// APPROVED statement. The source allocation remains immutable; APPLIED adds a
// reversal effect and a new replacement allocation in the same transaction.
model FinancePaymentAllocationAdjustment {
  id                      String                                   @id @default(uuid())
  legalEntityId           String
  businessUnitId          String
  sourceAllocationId      String
  replacementStatementId  String
  replacementAllocationId String?                                  @unique
  amountCents             BigInt
  status                  FinancePaymentAllocationAdjustmentStatus @default(PENDING)
  reason                  String
  idempotencyKey          String
  requestedByMembershipId String
  requestedAt             DateTime                                 @default(now())
  approvedByMembershipId  String?
  approvedAt              DateTime?
  approvalReason          String?
  rejectedByMembershipId  String?
  rejectedAt              DateTime?
  rejectionReason         String?
  cancelledByMembershipId String?
  cancelledAt             DateTime?
  cancellationReason      String?
  appliedByMembershipId   String?
  appliedAt               DateTime?
  createdAt               DateTime                                 @default(now())
  updatedAt               DateTime                                 @updatedAt

  legalEntity           LegalEntity                     @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  businessUnit          BusinessUnit                    @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  sourceAllocation      FinancePaymentAllocation        @relation("FinanceAllocationAdjustmentSource", fields: [sourceAllocationId], references: [id], onDelete: Restrict)
  replacementStatement  FinanceStatement                @relation("FinanceAllocationAdjustmentReplacementStatement", fields: [replacementStatementId], references: [id], onDelete: Restrict)
  replacementAllocation FinancePaymentAllocation?       @relation("FinanceAllocationAdjustmentReplacement", fields: [replacementAllocationId], references: [id], onDelete: Restrict)
  requestedByMembership Membership                      @relation("FinanceAllocationAdjustmentRequester", fields: [requestedByMembershipId], references: [id], onDelete: Restrict)
  approvedByMembership  Membership?                     @relation("FinanceAllocationAdjustmentApprover", fields: [approvedByMembershipId], references: [id], onDelete: SetNull)
  rejectedByMembership  Membership?                     @relation("FinanceAllocationAdjustmentRejecter", fields: [rejectedByMembershipId], references: [id], onDelete: SetNull)
  cancelledByMembership Membership?                     @relation("FinanceAllocationAdjustmentCanceller", fields: [cancelledByMembershipId], references: [id], onDelete: SetNull)
  appliedByMembership   Membership?                     @relation("FinanceAllocationAdjustmentApplier", fields: [appliedByMembershipId], references: [id], onDelete: SetNull)
  reversalEffect        FinancePaymentAllocationEffect?

  @@unique([sourceAllocationId, idempotencyKey])
  @@index([businessUnitId, status, requestedAt, id])
  @@index([replacementStatementId, status, requestedAt])
  @@index([requestedByMembershipId, requestedAt])
}

// Positive values keep money semantics clear: the effective allocation is the
// original amount minus all applied effects. Effects are append-only evidence.
model FinancePaymentAllocationEffect {
  id                    String                             @id @default(uuid())
  legalEntityId         String
  businessUnitId        String
  allocationId          String
  adjustmentId          String                             @unique
  type                  FinancePaymentAllocationEffectType @default(REVERSAL)
  amountCents           BigInt
  appliedByMembershipId String
  appliedAt             DateTime                           @default(now())
  createdAt             DateTime                           @default(now())

  legalEntity         LegalEntity                        @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  businessUnit        BusinessUnit                       @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  allocation          FinancePaymentAllocation           @relation("FinancePaymentAllocationEffects", fields: [allocationId], references: [id], onDelete: Restrict)
  adjustment          FinancePaymentAllocationAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Restrict)
  appliedByMembership Membership                         @relation("FinanceAllocationEffectApplier", fields: [appliedByMembershipId], references: [id], onDelete: Restrict)

  @@unique([allocationId, type])
  @@index([legalEntityId, businessUnitId])
  @@index([allocationId, createdAt])
  @@index([appliedByMembershipId, appliedAt])
}

// Business-unit policy for finance separation of duties. It is data rather
// than a role-name switch: authorized administrators may configure it without
// changing application code. A missing row is interpreted as the strict safe
// default by the finance service so a newly created business unit never loses
// maker/checker protection during setup.
model FinanceControlPolicy {
  id                                                        String   @id @default(uuid())
  legalEntityId                                             String
  businessUnitId                                            String   @unique
  // Optimistic concurrency token. A stale administrator must not overwrite
  // a newer finance-control change without reviewing it again.
  version                                                   Int      @default(1)
  requireStatementApproverDifferentFromCreator              Boolean  @default(true)
  requireStatementPosterDifferentFromCreator                Boolean  @default(true)
  requireStatementPosterDifferentFromApprover               Boolean  @default(true)
  requirePaymentApproverDifferentFromCreator                Boolean  @default(true)
  requirePaymentPosterDifferentFromCreator                  Boolean  @default(true)
  requirePaymentPosterDifferentFromApprover                 Boolean  @default(true)
  requireReconciliationResolverDifferentFromCreator         Boolean  @default(true)
  requirePaymentAllocatorDifferentFromCreator               Boolean  @default(true)
  requirePaymentAllocatorDifferentFromApprover              Boolean  @default(true)
  requireAllocationAdjustmentApproverDifferentFromRequester Boolean  @default(true)
  requireAllocationAdjustmentApplierDifferentFromRequester  Boolean  @default(true)
  requireAllocationAdjustmentApplierDifferentFromApprover   Boolean  @default(true)
  updatedByMembershipId                                     String?
  createdAt                                                 DateTime @default(now())
  updatedAt                                                 DateTime @updatedAt

  legalEntity         LegalEntity  @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  businessUnit        BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  updatedByMembership Membership?  @relation("FinanceControlPolicyUpdater", fields: [updatedByMembershipId], references: [id], onDelete: SetNull)

  @@index([legalEntityId])
  @@index([updatedByMembershipId, updatedAt])
}

model Expense {
