  order       Order                @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([exportBatchId, orderId])
  @@index([orderId])
  @@index([exportBatchId, orderNoSnapshot])
}

model LogisticsReturnImportBatch {
  id                      String                           @id @default(uuid())
