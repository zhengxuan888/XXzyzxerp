model InventoryBalance {
  id               String   @id @default(uuid())
  businessUnitId   String
  siteId           String
  skuId            String
  onHandQuantity   Int      @default(0)
  reservedQuantity Int      @default(0)
  version          Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  businessUnit BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  site         Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  sku          ProductSku   @relation(fields: [skuId], references: [id], onDelete: Restrict)

  @@unique([businessUnitId, siteId, skuId])
  @@index([skuId, siteId])
}

model InventoryTransaction {
  id                String                   @id @default(uuid())
  businessUnitId    String
  siteId            String
  skuId             String
  orderId           String?
  actorUserId       String
  actorMembershipId String
  type              InventoryTransactionType
  quantityDelta     Int
  onHandAfter       Int
  reservedAfter     Int
  idempotencyKey    String
  reason            String?
  createdAt         DateTime                 @default(now())

  businessUnit    BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  site            Site         @relation(fields: [siteId], references: [id], onDelete: Restrict)
  sku             ProductSku   @relation(fields: [skuId], references: [id], onDelete: Restrict)
  order           Order?       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  actorUser       User         @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  actorMembership Membership   @relation(fields: [actorMembershipId], references: [id], onDelete: Restrict)

  @@unique([businessUnitId, idempotencyKey])
  @@index([businessUnitId, siteId, skuId, createdAt])
  @@index([orderId])
}

model InventoryReservation {
  id             String                     @id @default(uuid())
  businessUnitId String
  siteId         String
  skuId          String
  orderId        String
  quantity       Int
  status         InventoryReservationStatus @default(ACTIVE)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  businessUnit BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  site         Site         @relation(fields: [siteId], references: [id], onDelete: Restrict)
  sku          ProductSku   @relation(fields: [skuId], references: [id], onDelete: Restrict)
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([orderId, skuId, siteId])
  @@index([businessUnitId, siteId, status])
}

model OrderItem {
  id             String  @id @default(uuid())
  orderId        String
  productId      String
  skuId          String?
  productName    String
  quantity       Int
  unitPriceCents Int
  subtotalCents  Int

  order   Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  sku     ProductSku? @relation(fields: [skuId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model Shipment {
  id                  String                  @id @default(uuid())
  orderId             String
  legalEntityId       String
  businessUnitId      String
  siteId              String?
  carrier             String?
  trackingNo          String?
  status              ShipmentStatus          @default(PENDING)
  shippedAt           DateTime?
  deliveredAt         DateTime?
  exceptionReason     String?
  exceptionSeverity   LogisticsIssueSeverity?
  workStatus          LogisticsWorkStatus     @default(MONITORING)
  ownerMembershipId   String?
  firstTrackedAt      DateTime?
  lastTrackedAt       DateTime?
  estimatedDeliveryAt DateTime?
  nextFollowUpAt      DateTime?
  closedAt            DateTime?
  closeReason         String?
  memo                String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  order                  Order                      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  legalEntity            LegalEntity                @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  businessUnit           BusinessUnit               @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  site                   Site?                      @relation(fields: [siteId], references: [id], onDelete: SetNull)
  ownerMembership        Membership?                @relation("ShipmentAftersalesOwner", fields: [ownerMembershipId], references: [id], onDelete: SetNull)
  events                 ShipmentEvent[]
  followUps              LogisticsFollowUp[]
  eventAnnotations       LogisticsEventAnnotation[]
  notificationDeliveries NotificationDelivery[]
  financeStatementLines  FinanceStatementLine[]
  financeReconciliations FinanceReconciliation[]

  @@unique([businessUnitId, trackingNo])
  @@index([orderId, status])
  @@index([businessUnitId, workStatus, nextFollowUpAt])
  @@index([ownerMembershipId, workStatus])
  @@index([businessUnitId, status, createdAt, id])
  @@index([businessUnitId, ownerMembershipId, createdAt, id])
}

model ShipmentEvent {
  id                String   @id @default(uuid())
  shipmentId        String
  occurredAt        DateTime @default(now())
  eventType         String
  statusMilestone   String?
  location          String?
  source            String   @default("MANUAL")
  externalEventKey  String?
  memo              String?
  actorMembershipId String?

  shipment               Shipment                  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  actorMembership        Membership?               @relation("MembershipShipmentEvents", fields: [actorMembershipId], references: [id], onDelete: SetNull)
  annotation             LogisticsEventAnnotation?
  notificationDeliveries NotificationDelivery[]

  @@unique([shipmentId, source, externalEventKey])
  @@index([shipmentId, occurredAt])
  @@index([shipmentId, occurredAt, id])
  @@index([shipmentId, eventType, occurredAt])
}

model LogisticsEventAnnotation {
  id                    String    @id @default(uuid())
  shipmentId            String
  shipmentEventId       String    @unique
  businessUnitId        String
  note                  String?
  tags                  String[]  @default([])
  isHandled             Boolean   @default(false)
  handledAt             DateTime?
  handledByMembershipId String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  shipment            Shipment      @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  shipmentEvent       ShipmentEvent @relation(fields: [shipmentEventId], references: [id], onDelete: Cascade)
  businessUnit        BusinessUnit  @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  handledByMembership Membership?   @relation("LogisticsAnnotationHandler", fields: [handledByMembershipId], references: [id], onDelete: SetNull)

  @@index([businessUnitId, isHandled, updatedAt])
  @@index([shipmentId, updatedAt])
}

model LogisticsFollowUp {
  id                String               @id @default(uuid())
  shipmentId        String
  businessUnitId    String
  actorUserId       String
  actorMembershipId String
  actionType        String
  fromStatus        LogisticsWorkStatus?
  toStatus          LogisticsWorkStatus?
  note              String?
  nextFollowUpAt    DateTime?
  createdAt         DateTime             @default(now())

  shipment        Shipment     @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  businessUnit    BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  actorUser       User         @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  actorMembership Membership   @relation(fields: [actorMembershipId], references: [id], onDelete: Restrict)

  @@index([shipmentId, createdAt])
  @@index([businessUnitId, toStatus, createdAt])
}

model LogisticsWorkbenchSetting {
  id                         String   @id @default(uuid())
  businessUnitId             String   @unique
  quickTags                  String[] @default([])
  cards                      Json
  alertRules                 Json     @default("[]")
  syncIntervalMinutes        Int      @default(30)
  feishuNotificationsEnabled Boolean  @default(false)
  feishuHighPriorityOnly     Boolean  @default(true)
  updatedByUserId            String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  businessUnit BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
}

model NotificationDelivery {
  id                String                     @id @default(uuid())
  businessUnitId    String
  shipmentId        String?
  shipmentEventId   String?
  channel           String
  eventType         String
  dedupeKey         String                     @unique
  status            NotificationDeliveryStatus @default(PENDING)
  attempts          Int                        @default(0)
  nextAttemptAt     DateTime                   @default(now())
  lockedAt          DateTime?
  lastError         String?
  providerMessageId String?
  sentAt            DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  businessUnit  BusinessUnit   @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  shipment      Shipment?      @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  shipmentEvent ShipmentEvent? @relation(fields: [shipmentEventId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([businessUnitId, channel, status])
  @@index([shipmentId, createdAt])
}

model FinanceCounterparty {
  id                    String                  @id @default(uuid())
  legalEntityId         String
  businessUnitId        String
  departmentId          String?
  code                  String
  name                  String
  type                  FinanceCounterpartyType
  isActive              Boolean                 @default(true)
  metadata              Json?
  createdByMembershipId String
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  legalEntity            LegalEntity                   @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  businessUnit           BusinessUnit                  @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  department             Department?                   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdByMembership    Membership                    @relation("FinanceCounterpartyCreator", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  statements             FinanceStatement[]
  reconciliations        FinanceReconciliation[]
  payments               FinancePayment[]
  statementTemplates     FinanceStatementTemplate[]
  statementImportBatches FinanceStatementImportBatch[]

  @@unique([businessUnitId, code])
  @@index([businessUnitId, isActive, name])
  @@index([departmentId, isActive])
  @@index([createdByMembershipId, createdAt])
}

model FinanceStatement {
  id                     String                 @id @default(uuid())
  legalEntityId          String
  businessUnitId         String
  departmentId           String?
  siteId                 String?
  counterpartyId         String
  statementNo            String
  type                   FinanceStatementType
  status                 FinanceStatementStatus @default(DRAFT)
  currency               String
  currencyScale          Int                    @default(2)
  totalAmountCents       BigInt
  periodStart            DateTime?
  periodEnd              DateTime?
  issuedAt               DateTime?
  confirmedAt            DateTime?
  approvedAt             DateTime?
  postedAt               DateTime?
  voidedAt               DateTime?
  externalReference      String?
  note                   String?
  exceptionReason        String?
  createdByMembershipId  String
  approvedByMembershipId String?
  postedByMembershipId   String?
  voidedByMembershipId   String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  legalEntity          LegalEntity                  @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  businessUnit         BusinessUnit                 @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  department           Department?                  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  site                 Site?                        @relation(fields: [siteId], references: [id], onDelete: SetNull)
  counterparty         FinanceCounterparty          @relation(fields: [counterpartyId], references: [id], onDelete: Restrict)
  createdByMembership  Membership                   @relation("FinanceStatementCreator", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  approvedByMembership Membership?                  @relation("FinanceStatementApprover", fields: [approvedByMembershipId], references: [id], onDelete: SetNull)
  postedByMembership   Membership?                  @relation("FinanceStatementPoster", fields: [postedByMembershipId], references: [id], onDelete: SetNull)
  voidedByMembership   Membership?                  @relation("FinanceStatementVoider", fields: [voidedByMembershipId], references: [id], onDelete: SetNull)
  lines                FinanceStatementLine[]
  paymentAllocations   FinancePaymentAllocation[]
  importSheet          FinanceStatementImportSheet? @relation("FinanceImportSheetStatement")

  @@unique([businessUnitId, counterpartyId, statementNo])
  @@index([businessUnitId, status, createdAt, id])
  @@index([businessUnitId, type, periodStart, periodEnd])
  @@index([departmentId, status, createdAt])
  @@index([counterpartyId, status])
}

model FinanceStatementLine {
  id                   String                          @id @default(uuid())
  statementId          String
  lineNo               Int
  orderId              String?
  shipmentId           String?
  sourceReference      String?
  description          String?
  currency             String
  currencyScale        Int                             @default(2)
  amountCents          BigInt
  reconciliationStatus FinanceLineReconciliationStatus @default(UNMATCHED)
  exceptionReason      String?
  sourceSnapshot       Json?
  createdAt            DateTime                        @default(now())
  updatedAt            DateTime                        @updatedAt

  statement       FinanceStatement        @relation(fields: [statementId], references: [id], onDelete: Restrict)
  order           Order?                  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  shipment        Shipment?               @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  reconciliations FinanceReconciliation[]

  @@unique([statementId, lineNo])
  @@index([statementId, reconciliationStatus, lineNo])
  @@index([orderId])
  @@index([shipmentId])
}

// A template is configuration data, not executable code. It describes
// permitted workbook sheets, header aliases and field mappings. New partners
// or workbook variants are added by configuration rather than code branches.
model FinanceStatementTemplate {
  id                    String   @id @default(uuid())
  legalEntityId         String
  businessUnitId        String
  departmentId          String?
  counterpartyId        String?
  code                  String
  name                  String
  description           String?
  configuration         Json
  version               Int      @default(1)
  isActive              Boolean  @default(true)
  createdByMembershipId String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  legalEntity         LegalEntity                   @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  businessUnit        BusinessUnit                  @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  department          Department?                   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  counterparty        FinanceCounterparty?          @relation(fields: [counterpartyId], references: [id], onDelete: Restrict)
  createdByMembership Membership                    @relation("FinanceStatementTemplateCreator", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  importBatches       FinanceStatementImportBatch[]

  @@unique([businessUnitId, code])
  @@index([businessUnitId, isActive, createdAt])
  @@index([departmentId, isActive])
  @@index([counterpartyId, isActive])
  @@index([createdByMembershipId, createdAt])
}

// This is the private, immutable staging record for a workbook. Confirming a
// batch is the only operation that creates FinanceStatement rows.
model FinanceStatementImportBatch {
  id                      String                            @id @default(uuid())
  legalEntityId           String
  businessUnitId          String
  departmentId            String?
  siteId                  String?
  templateId              String
  templateVersion         Int
  templateSnapshot        Json
  counterpartyId          String
  statementNoPrefix       String
  externalReference       String?
  periodStart             DateTime?
  periodEnd               DateTime?
  issuedAt                DateTime?
  originalName            String
  storageKey              String
  mimeType                String
  sizeBytes               Int
  sha256                  String
  status                  FinanceStatementImportBatchStatus @default(PREVIEWED)
  totalRows               Int                               @default(0)
  readyRows               Int                               @default(0)
  warningRows             Int                               @default(0)
  rejectedRows            Int                               @default(0)
  importedRows            Int                               @default(0)
  previewedByMembershipId String
  previewedAt             DateTime                          @default(now())
  confirmedByMembershipId String?
  confirmedAt             DateTime?
  cancelledByMembershipId String?
  cancelledAt             DateTime?
  cancellationReason      String?
  createdAt               DateTime                          @default(now())
  updatedAt               DateTime                          @updatedAt

  legalEntity           LegalEntity                   @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  businessUnit          BusinessUnit                  @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  department            Department?                   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  site                  Site?                         @relation(fields: [siteId], references: [id], onDelete: SetNull)
  template              FinanceStatementTemplate      @relation(fields: [templateId], references: [id], onDelete: Restrict)
  counterparty          FinanceCounterparty           @relation(fields: [counterpartyId], references: [id], onDelete: Restrict)
  previewedByMembership Membership                    @relation("FinanceStatementImportBatchPreviewer", fields: [previewedByMembershipId], references: [id], onDelete: Restrict)
  confirmedByMembership Membership?                   @relation("FinanceStatementImportBatchConfirmer", fields: [confirmedByMembershipId], references: [id], onDelete: SetNull)
  cancelledByMembership Membership?                   @relation("FinanceStatementImportBatchCanceller", fields: [cancelledByMembershipId], references: [id], onDelete: SetNull)
  sheets                FinanceStatementImportSheet[]

  @@index([businessUnitId, status, previewedAt, id])
  @@index([departmentId, status, previewedAt])
  @@index([counterpartyId, status])
  @@index([templateId, createdAt])
  @@index([previewedByMembershipId, previewedAt])
  @@index([businessUnitId, status, cancelledAt])
}

// A single workbook can contain multiple configured financial sheets. Each
// sheet becomes at most one DRAFT FinanceStatement during confirmation.
model FinanceStatementImportSheet {
  id                 String               @id @default(uuid())
  importBatchId      String
  sheetKey           String
  sheetName          String
  headerRowNumber    Int
  statementNo        String
  statementType      FinanceStatementType
  currency           String
  currencyScale      Int                  @default(2)
  totalAmountCents   BigInt
  totalRows          Int                  @default(0)
  readyRows          Int                  @default(0)
  warningRows        Int                  @default(0)
  rejectedRows       Int                  @default(0)
  importedRows       Int                  @default(0)
  createdStatementId String?              @unique
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  importBatch      FinanceStatementImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Restrict)
  createdStatement FinanceStatement?           @relation("FinanceImportSheetStatement", fields: [createdStatementId], references: [id], onDelete: Restrict)
  rows             FinanceStatementImportRow[]

  @@unique([importBatchId, sheetKey])
  @@unique([importBatchId, statementNo])
  @@index([importBatchId, createdAt])
}

model FinanceStatementImportRow {
  id                String                          @id @default(uuid())
  importSheetId     String
  rowNumber         Int
  sourceRowHash     String
  status            FinanceStatementImportRowStatus @default(READY)
  issueCodes        Json?
  message           String?
  sourceReference   String?
  trackingReference String?
  description       String?
  currency          String?
  currencyScale     Int?
  amountCents       BigInt?
  sourceSnapshot    Json?
  importedAt        DateTime?
  createdAt         DateTime                        @default(now())
  updatedAt         DateTime                        @updatedAt

  importSheet FinanceStatementImportSheet @relation(fields: [importSheetId], references: [id], onDelete: Restrict)

  @@unique([importSheetId, rowNumber])
  @@index([importSheetId, status, rowNumber])
  @@index([sourceReference])
  @@index([trackingReference])
}

model FinanceReconciliation {
  id                      String                      @id @default(uuid())
  legalEntityId           String
  businessUnitId          String
  counterpartyId          String
  statementType           FinanceStatementType
  statementLineId         String
  orderId                 String?
  shipmentId              String?
  amountCents             BigInt
  status                  FinanceReconciliationStatus @default(SUGGESTED)
  method                  FinanceMatchMethod          @default(MANUAL)
  reason                  String?
  createdByMembershipId   String
  confirmedByMembershipId String?
  confirmedAt             DateTime?
  voidedByMembershipId    String?
  voidedAt                DateTime?
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt

  legalEntity           LegalEntity          @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  businessUnit          BusinessUnit         @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  counterparty          FinanceCounterparty  @relation(fields: [counterpartyId], references: [id], onDelete: Restrict)
  statementLine         FinanceStatementLine @relation(fields: [statementLineId], references: [id], onDelete: Restrict)
  order                 Order?               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  shipment              Shipment?            @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  createdByMembership   Membership           @relation("FinanceReconciliationCreator", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  confirmedByMembership Membership?          @relation("FinanceReconciliationConfirmer", fields: [confirmedByMembershipId], references: [id], onDelete: SetNull)
  voidedByMembership    Membership?          @relation("FinanceReconciliationVoider", fields: [voidedByMembershipId], references: [id], onDelete: SetNull)

  @@unique([statementLineId, orderId])
  @@unique([statementLineId, shipmentId])
  @@index([statementLineId, status])
  @@index([businessUnitId, counterpartyId, statementType, status])
  @@index([orderId, status])
  @@index([shipmentId, status])
}

model FinancePayment {
  id                     String                  @id @default(uuid())
  legalEntityId          String
  businessUnitId         String
  departmentId           String?
  siteId                 String?
  counterpartyId         String
  paymentNo              String
  direction              FinancePaymentDirection
  status                 FinancePaymentStatus    @default(DRAFT)
  currency               String
  currencyScale          Int                     @default(2)
  amountCents            BigInt
  paidAt                 DateTime?
  approvedAt             DateTime?
  postedAt               DateTime?
  voidedAt               DateTime?
  externalReference      String?
  note                   String?
  voidReason             String?
  createdByMembershipId  String
  approvedByMembershipId String?
  postedByMembershipId   String?
  voidedByMembershipId   String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  legalEntity          LegalEntity                @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  businessUnit         BusinessUnit               @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  department           Department?                @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  site                 Site?                      @relation(fields: [siteId], references: [id], onDelete: SetNull)
  counterparty         FinanceCounterparty        @relation(fields: [counterpartyId], references: [id], onDelete: Restrict)
  createdByMembership  Membership                 @relation("FinancePaymentCreator", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  approvedByMembership Membership?                @relation("FinancePaymentApprover", fields: [approvedByMembershipId], references: [id], onDelete: SetNull)
  postedByMembership   Membership?                @relation("FinancePaymentPoster", fields: [postedByMembershipId], references: [id], onDelete: SetNull)
  voidedByMembership   Membership?                @relation("FinancePaymentVoider", fields: [voidedByMembershipId], references: [id], onDelete: SetNull)
  allocations          FinancePaymentAllocation[]

  @@unique([businessUnitId, paymentNo])
  @@index([businessUnitId, status, createdAt, id])
  @@index([departmentId, status, createdAt])
  @@index([counterpartyId, status])
}

model FinancePaymentAllocation {
  id                    String   @id @default(uuid())
  paymentId             String
  statementId           String
  amountCents           BigInt
  createdByMembershipId String
  createdAt             DateTime @default(now())

  payment             FinancePayment   @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  statement           FinanceStatement @relation(fields: [statementId], references: [id], onDelete: Restrict)
  createdByMembership Membership       @relation("FinancePaymentAllocationCreator", fields: [createdByMembershipId], references: [id], onDelete: Restrict)

  @@unique([paymentId, statementId])
  @@index([statementId, createdAt])
  @@index([createdByMembershipId, createdAt])
}

// Business-unit policy for finance separation of duties. It is data rather
// than a role-name switch: authorized administrators may configure it without
// changing application code. A missing row is interpreted as the strict safe
// default by the finance service so a newly created business unit never loses
// maker/checker protection during setup.
model FinanceControlPolicy {
  id                                           String   @id @default(uuid())
  legalEntityId                                String
  businessUnitId                               String   @unique
  // Optimistic concurrency token. A stale administrator must not overwrite
  // a newer finance-control change without reviewing it again.
  version                                      Int      @default(1)
  requireStatementApproverDifferentFromCreator Boolean  @default(true)
  requireStatementPosterDifferentFromCreator   Boolean  @default(true)
  requireStatementPosterDifferentFromApprover  Boolean  @default(true)
  requirePaymentApproverDifferentFromCreator   Boolean  @default(true)
  requirePaymentPosterDifferentFromCreator     Boolean  @default(true)
  requirePaymentPosterDifferentFromApprover    Boolean  @default(true)
  updatedByMembershipId                        String?
  createdAt                                    DateTime @default(now())
  updatedAt                                    DateTime @updatedAt

  legalEntity         LegalEntity  @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  businessUnit        BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  updatedByMembership Membership?  @relation("FinanceControlPolicyUpdater", fields: [updatedByMembershipId], references: [id], onDelete: SetNull)

  @@index([legalEntityId])
  @@index([updatedByMembershipId, updatedAt])
}

model Expense {
