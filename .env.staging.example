# 预发布模板：只能由密钥管理系统或服务器安全配置注入真实值，不得改名后提交。
NODE_ENV="production"
APP_BASE_URL="https://erp-staging.example.com"
PORT="3000"
DATABASE_URL="postgresql://<user>:<password>@<private-db-host>:5432/<database>?schema=public&sslmode=require"
REDIS_URL="rediss://:<password>@<private-redis-host>:6379"
SESSION_SECRET="<generate-at-least-32-random-characters>"
SESSION_TTL_SECONDS="28800"
SEED_FOUNDER_PASSWORD="<disabled-unless-explicitly-approved>"
STORAGE_PROVIDER="S3_OR_OSS_PRIVATE"
